<!-- Modal para mostrar la información del movimiento -->
<div class="modal fade" id="informacionMovimientoModal" tabindex="-1" aria-labelledby="informacionMovimientoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="informacionMovimientoModalLabel">Información del Movimiento</h5>
                <button type="button" class="close" id="closeInformacionModal" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p><strong>ID del Movimiento:</strong> <span id="movimientoId"></span></p>
                <p><strong>Fecha:</strong> <span id="movimientoFecha"></span></p>
                <p><strong>Producto:</strong> <span id="movimientoProductoNombre"></span></p>
                <p><strong>Cantidad:</strong> <span id="movimientoCantidad"></span></p>
                <p><strong>Descripción:</strong> <span id="movimientoDescripcion"></span></p>
            </div>
        </div>
    </div>
</div>
