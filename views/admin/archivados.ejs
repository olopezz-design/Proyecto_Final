<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pacientes Archivados - C&C Dental Studio </title>
    <link rel="shortcut icon" type="image/svg+xml" href="/images/cnc-favicon.svg">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            color: #007bff;
            background-color: transparent;
            border: none;
            padding: 0;
            margin: 0 5px;
            font-size: 14px;
            cursor: pointer;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            font-weight: bold;
            color: white;
            background-color: #007bff;
            border: none;
            border-radius: 4px;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            color: white;
            background-color: #0056b3;
            border: none;
            border-radius: 4px;
        }
        .dataTables_filter {
          display: none;
        }
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
        }
        #page-content-wrapper {
            flex: 1;
        }
        footer {
            position: relative;
            bottom: 0;
            width: 100%;
            background-color: #343a40;
            color: white;
            text-align: center;
            padding: 10px 0;
        }
        .modal-body {
            max-height: 400px;
            overflow-y: auto;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <div class="d-flex flex-grow-1" id="wrapper">
        <!-- Sidebar -->
        <div class="bg-dark border-right" id="sidebar-wrapper">
            <div class="sidebar-heading text-center py-4">
                <img src="/images/cnc-logo-alt.svg" alt="Logo" class="img-fluid mb-2" style="max-width: 50px;">
                <h4 class="text-white font-weight-bold">C&C Dental Studio</h4>
            </div>
            <div class="list-group list-group-flush">
                
                <!-- Pacientes -->
                <a href="#clientes-pacientes-submenu" class="list-group-item list-group-item-action bg-dark text-white d-flex justify-content-between align-items-center" data-toggle="collapse">
                    <i class="fas fa-user mr-2"></i> Pacientes
                    <i class="fas fa-chevron-down"></i>
                </a>
                <div id="clientes-pacientes-submenu" class="collapse">
                    <a href="/admin/pacientes" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-user-friends"></i> Lista de Pacientes
                    </a>
                    <a href="/admin/citas" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-calendar-alt"></i> Citas
                    </a>
                    <a href="/admin/historial" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-file-medical-alt"></i> Historial Tratamiento
                    </a>
                    <a href="/admin/pago" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-wallet"></i> Control de Pago
                    </a>
                    <a href="/admin/archivados" class="list-group-item list-group-item-action bg-dark text-white pl-5 active">
                        <i class="fas fa-archive"></i> Pacientes Archivados
                    </a>
                </div>

                <!-- Doctores -->
                <a href="#doctores-submenu" class="list-group-item list-group-item-action bg-dark text-white d-flex justify-content-between align-items-center" data-toggle="collapse">
                    <i class="fas fa-user-md mr-2"></i> Doctores
                    <i class="fas fa-chevron-down"></i>
                </a>
                <div id="doctores-submenu" class="collapse">
                    <a href="/admin/doctores" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-user-check"></i> Doctores Activos
                    </a>
                    <a href="/admin/doctoresInactivos" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-user-slash"></i> Doctores Inactivos
                    </a>
                </div>

                <!-- Inventario -->
                <a href="#inventario-submenu" class="list-group-item list-group-item-action bg-dark text-white d-flex justify-content-between align-items-center" data-toggle="collapse">
                    <i class="fas fa-box mr-2"></i> Inventario
                    <i class="fas fa-chevron-down"></i>
                </a>
                <div id="inventario-submenu" class="collapse">
                    <a href="/admin/marcas" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-tags"></i> Marcas
                    </a>
                    <a href="/admin/categorias" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-th-large"></i> Categorías
                    </a>
                    <a href="/admin/proveedores" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-truck"></i> Proveedores
                    </a>
                    <a href="/admin/productos" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-boxes"></i> Productos
                    </a>
                    <a href="/admin/comprasProductos" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-shopping-cart"></i> Compras
                    </a>
                    <a href="/admin/salidasProductos" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-dolly"></i> Salidas
                    </a>
                </div>

                <a href="/admin/cotizaciones" class="list-group-item list-group-item-action bg-dark text-white">
                    <i class="fas fa-file-invoice"></i> Generar Cotización
                </a>
                <a href="/admin/dashboard" class="list-group-item list-group-item-action bg-dark text-white">
                    <i class="fas fa-arrow-circle-left"></i> Regresar al Panel
                </a>
                <a href="/logout" class="list-group-item list-group-item-action bg-danger text-white">
                    <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                </a>
            </div>
        </div>
        <!-- Contenido de la Página -->
        <div id="page-content-wrapper">
            <div class="container-fluid">
                <h1 class="mt-4">Pacientes Archivados</h1>
                <div class="text-left mb-3">
                    <a href="/admin/dashboard" class="btn btn-secondary">&larr; Regresar al Panel de Control</a>
                </div>

                <!-- Tabla de pacientes -->
                <div class="card">
                    <div class="card-header">Listado de Pacientes</div>
                    <div class="card-body">
                        <table id="pacienteTable" class="table table-striped">
                            <thead>
                                <tr>
                                    <th>DPI</th>
                                    <th>Nombre</th>
                                    <th>Teléfono</th>
                                    <th>Email</th>
                                    <th>Edad</th>
                                    <th>Tipo de Paciente</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% pacientes.forEach(function(paciente) { %>
                                    <tr>
                                        <td><%= paciente.dpi %></td>
                                        <td><%= paciente.nombre +" "+ paciente.apellido%></td>
                                        <td><%= paciente.telefono %></td>
                                        <td><%= paciente.email %></td>
                                        <td><%= paciente.edad %></td>
                                        <td>
                                            <% if (paciente.tipoPaciente_idtipoPaciente == 1) { %>
                                                Nuevo Paciente
                                            <% } else if (paciente.tipoPaciente_idtipoPaciente == 2) { %>
                                                Paciente Recurrente
                                            <% } else { %>
                                                Paciente de Emergencia
                                            <% } %> 
                                        </td>
                                        <td class="d-flex justify-content-around">
                                           
                                            <% if (can('pacientes:archivar')) { %>
                                                <!-- Botón para desarchivar paciente -->
                                                <form onsubmit="event.preventDefault(); archivarPaciente('<%= paciente.idPaciente %>')">
                                                    <button class="btn btn-secondary btn-sm" type="submit" title="Desarchivar">
                                                        <i class="fas fa-archive fa-lg"></i>
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <span class="text-muted">Solo lectura</span>
                                            <% } %>
                                            
                                        </td>
                                                            
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    
    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
    <script src="/js/dashboard.js"></script>
    <script>
        $(document).ready(function() {
            $('#pacienteTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                info: true,
                lengthChange: false,
                language: {
                    paginate: { previous: "<", next: ">" },
                    emptyTable: "No hay datos disponibles en la tabla"
                }
            });
        });

       
//función para archivar un paciente

function archivarPaciente(idPaciente) {
    fetch(`/api/admin/pacientes/${idPaciente}/desarchivar`, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Error al archivar el paciente');
        }
        return response.json();
    })
    .then(data => {
        showUiMessage(data.message || 'Paciente actualizado correctamente.', 'success');
        // Aquí puedes recargar la lista de pacientes o actualizar el estado en la interfaz
        location.reload(); // Esto recarga la página para ver los cambios (opcional)
    })
    .catch(error => {
        console.error('Error:', error);
        showUiMessage('Hubo un problema al actualizar el paciente.', 'danger');
    });
}



    </script>
<%- include('partials/uiFeedback') %>

<%- include('partials/pageLoader') %>
</body>
</html>
