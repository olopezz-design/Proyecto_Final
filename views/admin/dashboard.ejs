<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Administrador - C&C Dental Studio</title>
    <link rel="shortcut icon" type="image/svg+xml" href="/images/cnc-favicon.svg">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body class="d-flex flex-column min-vh-100">
    <div class="d-flex flex-grow-1" id="wrapper">
        <!-- Sidebar -->
        <div class="bg-dark border-right" id="sidebar-wrapper">
            <div class="sidebar-heading text-center py-4">
                <img src="/images/cnc-logo-alt.svg" alt="Logo" class="img-fluid mb-2" style="max-width: 50px;">
                <h4 class="text-white font-weight-bold">C&C Dental Studio</h4>
            </div>
            <div class="list-group list-group-flush">
                
                <!-- Pacientes -->
                <a href="#clientes-pacientes-submenu" class="list-group-item list-group-item-action bg-dark text-white d-flex justify-content-between align-items-center" data-toggle="collapse">
                    <i class="fas fa-user mr-2"></i> Pacientes
                    <i class="fas fa-chevron-down"></i>
                </a>
                <div id="clientes-pacientes-submenu" class="collapse">
                    <a href="/admin/pacientes" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-user-friends"></i> Lista de Pacientes
                    </a>
                    <a href="/admin/citas" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-calendar-alt"></i> Citas
                    </a>
                    <a href="/admin/historial" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-file-medical-alt"></i> Historial Tratamiento
                    </a>
                    <a href="/admin/pago" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-wallet"></i> Control de Pago
                    </a>
                    <a href="/admin/archivados" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-archive"></i> Pacientes Archivados
                    </a>
                </div>

                <!-- Doctores -->
                <a href="#doctores-submenu" class="list-group-item list-group-item-action bg-dark text-white d-flex justify-content-between align-items-center" data-toggle="collapse">
                    <i class="fas fa-user-md mr-2"></i> Doctores
                    <i class="fas fa-chevron-down"></i>
                </a>
                <div id="doctores-submenu" class="collapse">
                    <a href="/admin/doctores" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-user-check"></i> Doctores Activos
                    </a>
                    <a href="/admin/doctoresInactivos" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-user-slash"></i> Doctores Inactivos
                    </a>
                </div>

                <!-- Inventario -->
                <a href="#inventario-submenu" class="list-group-item list-group-item-action bg-dark text-white d-flex justify-content-between align-items-center" data-toggle="collapse">
                    <i class="fas fa-box mr-2"></i> Inventario
                    <i class="fas fa-chevron-down"></i>
                </a>
                <div id="inventario-submenu" class="collapse">
                    <a href="/admin/marcas" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-tags"></i> Marcas
                    </a>
                    <a href="/admin/categorias" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-th-large"></i> Categorías
                    </a>
                    <a href="/admin/proveedores" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-truck"></i> Proveedores
                    </a>
                    <a href="/admin/productos" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-boxes"></i> Productos
                    </a>
                    <a href="/admin/comprasProductos" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-shopping-cart"></i> Compras
                    </a>
                    <a href="/admin/salidasProductos" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-dolly"></i> Salidas
                    </a>
                </div>

                <a href="/admin/cotizaciones" class="list-group-item list-group-item-action bg-dark text-white active">
                    <i class="fas fa-file-invoice"></i> Generar Cotización
                </a>
                <a href="/admin/dashboard" class="list-group-item list-group-item-action bg-dark text-white">
                    <i class="fas fa-arrow-circle-left"></i> Regresar al Panel
                </a>
                <a href="/logout" class="list-group-item list-group-item-action bg-danger text-white">
                    <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                </a>
            </div>
        </div>
        
        <!-- Page Content -->
        <div id="page-content-wrapper" class="flex-grow-1">
            <div class="container-fluid">
                <h1 class="mt-4 text-center">Panel de Control</h1>
                <p class="text-center text-muted">Bienvenido al sistema de gestión de la clínica dental.</p>
            
                <!-- Tarjetas de Resumen en diseño 2x2 -->
                <div class="row justify-content-center">
                    <!-- Primera fila de tarjetas -->
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card text-white shadow-lg border-0 rounded-lg bg-gradient-primary h-100">
                            <div class="card-body text-center">
                                <div class="icon-circle bg-white text-primary mb-3">
                                    <i class="fas fa-users fa-3x"></i>
                                </div>
                                <h5 class="card-title display-4 mb-0"><%= activeUserCount %></h5>
                                <p class="font-weight-bold">Usuarios Activos</p>
                                <p class="small text-white-50">Usuarios que han iniciado sesión en los últimos 30 días</p>
                            </div>
                        </div>
                    </div>
            
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card text-white shadow-lg border-0 rounded-lg bg-gradient-success h-100">
                            <div class="card-body text-center">
                                <div class="icon-circle bg-white text-success mb-3">
                                    <i class="fas fa-user-plus fa-3x"></i>
                                </div>
                                <h5 class="card-title display-4 mb-0"><%= totalPatients %></h5>
                                <p class="font-weight-bold">Pacientes Ingresados</p>
                                <p class="small text-white-50">Número de pacientes actualmente registrados en el sistema</p>
                            </div>
                        </div>
                    </div>
                </div>
            <!-- Segunda fila de tarjetas -->
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4 mb-4">
      <div class="card shadow-lg border-0 rounded-lg h-100" style="background-color: #FFDDC1;">
        <div class="card-body text-center">
          <div class="icon-circle bg-white text-warning mb-3">
            <i class="fas fa-boxes fa-3x"></i>
          </div>
          <h5 class="card-title display-4 mb-0 text-dark font-weight-bold"><%= totalProducts %></h5>
          <p class="font-weight-bold text-dark">Productos Ingresados</p>
          <p class="small text-dark">Número de productos actualmente en inventario</p>
        </div>
      </div>
    </div>
  
    <div class="col-md-6 col-lg-4 mb-4">
      <div class="card shadow-lg border-0 rounded-lg h-100" style="background-color: #C1E1FF;">
        <div class="card-body text-center">
          <div class="icon-circle bg-white text-info mb-3">
            <i class="fas fa-truck fa-3x"></i>
          </div>
          <h5 class="card-title display-4 mb-0 text-dark font-weight-bold"><%= totalProviders %></h5>
          <p class="font-weight-bold text-dark">Proveedores</p>
          <p class="small text-dark">Número total de proveedores registrados</p>
        </div>
      </div>
    </div>
  </div>
            </div>
        </div>

  <br>
  
    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3 mt-auto">
        <p class="mb-0">&copy; 2024 C&C Dental Studio. Todos los derechos reservados.</p>
    </footer>

    <style>
        /* Sidebar */
        #sidebar-wrapper {
            width: 250px;
            background-color: #2c3e50;
            color: #ecf0f1;
            height: 100vh;
        }
        .list-group-item {
            font-size: 1.1rem;
            transition: background 0.3s;
        }
        .list-group-item:hover {
            background-color: #34495e;
        }

        /* Submenu indent and icon styling */
        .list-group-item-action .pl-5 {
            padding-left: 2.5rem;
        }

        /* Submenu style */
        .list-group-item-action.collapse.show .list-group-item {
            background: #2c3e50;
        }

        /* Card gradients */
        .bg-gradient-primary {
            background: linear-gradient(135deg, #4a69bd, #1e3799);
        }
        .bg-gradient-success {
            background: linear-gradient(135deg, #78e08f, #38ada9);
        }

        /* Icon circle */
        .icon-circle {
            width: 70px;
            height: 70px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 50%;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        /* Card style */
        .display-4 {
            font-size: 2.5rem;
            font-weight: bold;
        }
        .card {
            border-radius: 15px;
        }
        .card .card-body p {
            margin: 0;
        }
    </style>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="js/dashboard.js"></script>
    <script>
        // Toggle sidebar
        $("#menu-toggle").click(function(e) {
            e.preventDefault();
            $("#wrapper").toggleClass("toggled");
            $(this).find("i").toggleClass("fa-chevron-left fa-chevron-right");
        });
    </script>

<%- include('partials/pageLoader') %>
</body>
</html>
