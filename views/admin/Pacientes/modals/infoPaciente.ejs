<!-- Modal para mostrar la información del paciente -->
<div class="modal fade" id="infopacienteModal" tabindex="-1" aria-labelledby="infopacienteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title" id="infopacienteModalLabel">Información del Paciente</h5>
          <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <table class="table table-bordered">
            <tbody>
              <tr><th>Nombre</th><td id="infopacienteName"></td></tr>
              <tr><th>Apellido</th><td id="infopacienteLastName"></td></tr>
              <tr><th>DPI</th><td id="infopacienteDpi"></td></tr>
              <tr><th>Teléfono</th><td id="infopacientePhone"></td></tr>
              <tr><th>Email</th><td id="infopacienteEmail"></td></tr>
              <tr><th>Edad</th><td id="infopacienteEdad"></td></tr>
              <tr><th>Género</th><td id="infopacienteGenero"></td></tr>
              <tr><th>Fecha de Nacimiento</th><td id="infopacienteFechaNacimiento"></td></tr>
              <tr><th>Dirección</th><td id="infopacienteDireccion"></td></tr>
              <tr><th>NIT</th><td id="infopacienteNit"></td></tr>
              <tr><th>Tipo de Paciente</th><td id="infopacienteTipoPaciente"></td></tr>
              <tr><th>Historial Clínico</th><td id="infopacienteHistorialClinico"></td></tr>
              <tr><th>Ficha Médica</th><td id="infopacienteFichaMedica"></td></tr>
            </tbody>
          </table>
        </div>
        <div class="modal-footer">
          <button class="btn btn-danger" onclick="downloadPDF()">Descargar PDF</button>
        </div>
      </div>
    </div>
  </div>

<script>
    function downloadPDF() {
  const patientData = {
    nombre: document.getElementById('infopacienteName').textContent,
    apellido: document.getElementById('infopacienteLastName').textContent,
    dpi: document.getElementById('infopacienteDpi').textContent,
    telefono: document.getElementById('infopacientePhone').textContent,
    email: document.getElementById('infopacienteEmail').textContent,
    edad: document.getElementById('infopacienteEdad').textContent,
    genero: document.getElementById('infopacienteGenero').textContent,
    fechaNacimiento: document.getElementById('infopacienteFechaNacimiento').textContent,
    direccion: document.getElementById('infopacienteDireccion').textContent,
    nit: document.getElementById('infopacienteNit').textContent,
    tipoPaciente: document.getElementById('infopacienteTipoPaciente').textContent,
    historialClinico: document.getElementById('infopacienteHistorialClinico').textContent,
    fichaMedica: document.getElementById('infopacienteFichaMedica').textContent,
  };

  fetch('/api/paciente/reporte', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(patientData)
  })
  .then(response => response.blob())
  .then(blob => {
    const url = window.URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'Paciente_Reporte.pdf';
    a.click();
    window.URL.revokeObjectURL(url);
  })
  .catch(error => console.error('Error al descargar el PDF:', error));
}

</script>
