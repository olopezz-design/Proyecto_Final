<!-- Modal para agregar paciente -->
<div class="modal fade" id="addpacienteModal" tabindex="-1" aria-labelledby="addpacienteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addpacienteModalLabel">Agregar Paciente</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="addPacienteForm" action="/admin/pacientes/agregar" method="POST">
                    <h4>Información Personal</h4>
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <td><label for="addNombre"><i class="fas fa-user"></i> Nombre</label></td>
                                <td><input type="text" class="form-control" id="addNombre" name="nombre" required></td>
                                <td><label for="addApellido"><i class="fas fa-user"></i> Apellido</label></td>
                                <td><input type="text" class="form-control" id="addApellido" name="apellido" required></td>
                            </tr>
                            <tr>
                                <td><label for="addTelefono"><i class="fas fa-phone"></i> Teléfono</label></td>
                                <td><input type="text" class="form-control" id="addTelefono" name="telefono" required></td>
                                <td><label for="addEmail"><i class="fas fa-envelope"></i> Email</label></td>
                                <td><input type="email" class="form-control" id="addEmail" name="email" required></td>
                            </tr>
                            <tr>
                                <td><label for="addEdad"><i class="fas fa-birthday-cake"></i> Edad</label></td>
                                <td><input type="number" class="form-control" id="addEdad" name="edad" readonly></td>
                                <td><label for="addFechaNacimiento"><i class="fas fa-calendar-alt"></i> Fecha de Nacimiento</label></td>
                                <td><input type="date" class="form-control" id="addFechaNacimiento" name="fechaNacimiento" required></td>
                            </tr>
                            <tr>
                                <td><label for="addDireccion"><i class="fas fa-map-marker-alt"></i> Dirección</label></td>
                                <td><input type="text" class="form-control" id="addDireccion" name="direccion" required></td>
                                <td><label for="addNit"><i class="fas fa-id-card"></i> NIT</label></td>
                                <td><input type="text" class="form-control" id="addNit" name="nit" required></td>
                            </tr>
                            <tr>
                                <td><label for="addDPI"><i class="fas fa-id-card"></i> DPI</label></td>
                                <td><input type="text" class="form-control" id="addDPI" name="dpi" required></td>
                                <td><label for="addTipoPaciente"><i class="fas fa-user-tag"></i> Tipo de Paciente</label></td>
                                <td>
                                    <select class="form-control" id="addTipoPaciente" name="tipoPaciente_idtipoPaciente" required>
                                        <option value="">Seleccione el tipo de paciente</option>
                                        <option value="1">Nuevo Paciente</option>
                                        <option value="2">Paciente Recurrente</option>
                                        <option value="3">Paciente de Emergencia</option>
                                    </select>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="addGenero"><i class="fas fa-venus-mars"></i> Género</label></td>
                                <td colspan="3">
                                    <select class="form-control" id="addGenero" name="genero_idGenero" required>
                                        <option value="">Seleccione el género</option>
                                        <option value="1">Masculino</option>
                                        <option value="2">Femenino</option>
                                        <option value="3">Otro</option>
                                    </select>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div>
                        <h4>Ficha Médica</h4>
                        <h6>Marque con un chequesito si la respuesta de la pregunta es SÍ</h6>
                    </div>

                    <div class="form-group">
                        <table class="table table-borderless">
                            <tbody>
                                <tr>
                                    <td class="text-left">1. ¿Tiene alguna enfermedad del corazón?</td>
                                    <td class="text-right"><input type="checkbox" id="enfermedad_corazon" name="enfermedad_corazon" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">2. ¿Presión alta o baja?</td>
                                    <td class="text-right"><input type="checkbox" id="presion_alta_baja" name="presion_alta_baja" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">3. ¿Es diabético?</td>
                                    <td class="text-right"><input type="checkbox" id="diabetico" name="diabetico" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">4. ¿Ha tenido operaciones recientes?</td>
                                    <td class="text-right"><input type="checkbox" id="operaciones_recientes" name="operaciones_recientes" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">5. ¿Ha tenido hepatitis?</td>
                                    <td class="text-right"><input type="checkbox" id="hepatitis" name="hepatitis" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">6. ¿Enfermedades del hígado o riñones?</td>
                                    <td class="text-right"><input type="checkbox" id="enfermedad_higado_rinones" name="enfermedad_higado_rinones" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">7. ¿Convulsiones o desmayos?</td>
                                    <td class="text-right"><input type="checkbox" id="convulsiones_desmayos" name="convulsiones_desmayos" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">8. ¿Enfermedades de transmisión sexual?</td>
                                    <td class="text-right"><input type="checkbox" id="enfermedad_transmision_sexual" name="enfermedad_transmision_sexual" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">9. ¿Tiene alguna alergia?</td>
                                    <td class="text-right"><input type="checkbox" id="alergias" name="alergias" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">10. ¿Tiene enfermedades respiratorias?</td>
                                    <td class="text-right"><input type="checkbox" id="enfermedad_respiratoria" name="enfermedad_respiratoria" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">11. ¿Está embarazada?</td>
                                    <td class="text-right"><input type="checkbox" id="embarazada" name="embarazada" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">12. ¿Sufre de artritis?</td>
                                    <td class="text-right"><input type="checkbox" id="artritis" name="artritis" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">13. ¿Fiebre reumática?</td>
                                    <td class="text-right"><input type="checkbox" id="fiebre_reumatica" name="fiebre_reumatica" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">14. ¿Hemorragias espontáneas?</td>
                                    <td class="text-right"><input type="checkbox" id="hemorragias_espontaneas" name="hemorragias_espontaneas" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">15. ¿Tiene alguna otra enfermedad?</td>
                                    <td class="text-right"><input type="checkbox" id="enfermedad_no_mencionada" name="enfermedad_no_mencionada" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">16. ¿Alergia a material odontológico?</td>
                                    <td class="text-right"><input type="checkbox" id="alergia_material_odontologico" name="alergia_material_odontologico" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">17. ¿Sangrado de encías?</td>
                                    <td class="text-right"><input type="checkbox" id="sangrado_encias" name="sangrado_encias" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">18. ¿Halitosis?</td>
                                    <td class="text-right"><input type="checkbox" id="halitosis" name="halitosis" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">19. ¿Alergia a algún medicamento?</td>
                                    <td class="text-right"><input type="checkbox" id="alergia_medicamento" name="alergia_medicamento" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">20. ¿Aftas?</td>
                                    <td class="text-right"><input type="checkbox" id="aftas" name="aftas" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">21. ¿Dolor dental?</td>
                                    <td class="text-right"><input type="checkbox" id="dolor_dental" name="dolor_dental" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">22. ¿Sensibilidad dental?</td>
                                    <td class="text-right"><input type="checkbox" id="sensibilidad" name="sensibilidad" class="form-check-input"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">23. ¿Cuándo fue su última visita al dentista?</td>
                                    <td class="text-right"><input type="text" id="ultima_visita_dentista" name="ultima_visita_dentista" class="form-control"></td>
                                </tr>
                                <tr>
                                    <td class="text-left">24. ¿Qué tratamiento se le ha realizado?</td>
                                    <td class="text-right"><input type="text" id="tratamiento_realizado" name="tratamiento_realizado" class="form-control"></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <br>
                    <div class="card mt-4">
                        <div class="card-header">
                            <h4>Contactos de Emergencia</h4>
                        </div>
                        <div class="card-body">
                            <div class="form-group">
                                <label for="contactoemergencia_nombre"><i class="fas fa-user"></i> Nombre</label>
                                <input type="text" class="form-control" id="contactoemergencia_nombre" name="contactoemergencia_nombre" required>
                            </div>
                            <div class="form-group">
                                <label for="contactoemergencia_numero"><i class="fas fa-phone"></i> Número</label>
                                <input type="text" class="form-control" id="contactoemergencia_numero" name="contactoemergencia_numero" required>
                            </div>
                            <div class="form-group">
                                <label for="contactoemergencia_parentesco"><i class="fas fa-users"></i> Parentesco</label>
                                <input type="text" class="form-control" id="contactoemergencia_parentesco" name="contactoemergencia_parentesco" required>
                            </div>
                        </div>
                    </div>
                    <br>
                    <button type="submit" class="btn btn-success">Agregar Paciente</button>
                </form>
            </div>
        </div>
    </div>
</div>
