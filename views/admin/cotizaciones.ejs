                                <path d="M 46 0 C 44 23 66 19 60 60 C 48 73 36 62 33 57 C 25 67 8 69 5 60 C 0 20 19 23 18 0 C 22.6667 7.3333 27.3333 14.6667 32 22 Z" fill="#ccc" transform="rotate(180, 32, 35)"/>
                                <text x="32" y="85" font-size="14" text-anchor="middle" fill="#333" font-weight="bold">17</text>
                            </svg>
                        </div>
                    </div>
                </div>                  
                
            </div>

            <h1 class="mt-4"></h1>

            <!-- Buttons -->
            <% if (can('cotizaciones:crear')) { %>
                <div class="mt-3">
                    <button class="btn btn-primary" onclick="openTreatmentModalForAll()">Tratamiento para Todos los Dientes</button>
                    <button class="btn btn-success" onclick="openTreatmentModalForSelection()">Aceptar Selección</button>
                </div>
            <% } %>

            <h1 class="mt-4"></h1>

            <!-- Tabla de Tratamientos -->
            <!-- Tabla de Tratamientos -->
<div class="card">
    <div class="card-header">Listado de Tratamientos</div>
    <div class="card-body">
        <table id="cotizacionTable" class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Diente</th>
                    <th>Tratamiento</th>
                    <th>Servicio</th>
                    <th>Notas</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                <!-- Verifica si hay cotizaciones agrupadas -->
                <% if (cotizacionesAgrupadas && cotizacionesAgrupadas.length > 0) { %>
                    <% cotizacionesAgrupadas.forEach(function(cotizacion) { %>
                        <% cotizacion.detalles.forEach(function(detalle) { %>
                            <tr>
                                <td><%= detalle.diente %></td>
                                <td><%= detalle.nombre_tratamiento %></td>
                                <td><%= detalle.nombre_servicio %></td>
                                <td><%= detalle.notas || 'Sin notas' %></td>
                                <td>
                                    
                                </td>
                            </tr>
                        <% }); %>
                        <tr class="table-primary font-weight-bold">
                            <td colspan="3"></td>
                            <td >Notas: <%= cotizacion.notas_adicionales || 'Sin notas' %></td>
                            <td colspan="1">Sub-Total: Q<%= cotizacion.costo_total.toFixed(2) %></td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center">No hay cotizaciones disponibles.</td>
                    </tr>
                <% } %>                
            </tbody>
            <tfoot>
                <tr>
                    <tr class="table-success font-weight-bold">
                        <td colspan="4" class="text-right">Total General:</td>
                        <td id="totalGeneralValue">Q0.00</td>
                    </tr>
                </tr>
                <tr>
                    <td colspan="5" class="text-center font-italic">Fin del listado de tratamientos</td>
                </tr>
            </tfoot>
        </table>
        <button id="saveTable" class="btn btn-success">Generar PDF</button>
    </div>
</div>

    <% if (can('cotizaciones:crear')) { %>
        <%- include('Cotizaciones/modals/treatmentModal') %>
    <% } %>

    <!-- Scripts -->
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.bundle.min.js"></script>
    <script src="/js/dashboard.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.4.0/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.23/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script>
        // Variables globales
        let selectedTeeth = []; // Dientes seleccionados
        let tratamientos = []; // Lista de tratamientos
        let cotizaciones = []; // Lista de cotizaciones
        let cotizacionTable;
    
        // Document Ready: Inicializa los eventos y configuraciones
        $(document).ready(function () {

            // Declarar referencias a elementos del DOM
            const $paciente = $("#paciente");
            const $tipoServicio = $("#tipoServicio");
            const $buscarServicio = $("#buscarServicio");

    
            // Asignar eventos
            $("#guardarCotizacion").on("click", function (e) {
                e.preventDefault(); // Prevenir el comportamiento predeterminado del formulario
                guardarCotizacion(); // Llamar a la función
            });
            $("#applyAllButton").on("click", openTreatmentModalForAll);
            $("#applySelectionButton").on("click", openTreatmentModalForSelection);
    
            // Actualizar el costo total dinámicamente
            $("#cantidad, #costoUnitario").on("input", updateCostoTotal);
    
            // Botón para generar el PDF
            $('#saveTable').on('click', function () {
                $(this).prop("disabled", true).text("Generando PDF...");
                setTimeout(() => $(this).prop("disabled", false).text("Generar PDF"), 3000);
            });

        });
    
        /**
         * Inicializar DataTable.
         */
         function initializeDataTable() {
    if ($("#cotizacionTable tbody tr").length > 0) {
        if ($.fn.DataTable.isDataTable("#cotizacionTable")) {
            $("#cotizacionTable").DataTable().destroy();
        }

        $("#cotizacionTable").DataTable({
            dom: 'Bfrtip',
            buttons: ['copy', 'csv', 'excel', 'pdf', 'print'],
            deferRender: true,
            paging: true,
            searching: true,
            ordering: true,
            info: true,
            lengthChange: true,
            language: {
                paginate: {
                    previous: "<",
                    next: ">",
                },
                emptyTable: "No hay cotizaciones disponibles.",
                search: "Buscar:",
            },
            order: [],
        });
    }
}
    
        /**
         * Seleccionar o deseleccionar un diente.
         * @param {number} toothNumber - Número del diente seleccionado.
         */
        function selectTooth(toothNumber) {
            const toothElement = $(`.tooth[data-tooth="${toothNumber}"]`);
    
            if (selectedTeeth.includes(toothNumber)) {
                // Deseleccionar el diente
                selectedTeeth = selectedTeeth.filter((tooth) => tooth !== toothNumber);
                toothElement.removeClass("selected");
            } else {
                // Seleccionar el diente
                selectedTeeth.push(toothNumber);
                toothElement.addClass("selected");
            }
    
            console.log("Dientes seleccionados:", selectedTeeth);
        }
    
        /**
         * Guardar la cotización.
         */
         function guardarCotizacion() {
    if (!validateFormInputs()) return;

    const cotizacionData = {
        paciente: parseInt($("#paciente").val(), 10),
        tipoServicio: $("#tipoServicio").val(),
        servicio: $("#buscarServicio").val(),
        costoServicio: parseFloat($("#costoServicio").val()),
        notas: $("#notas").val(),
        dientes: selectedTeeth // Enviará "1-32" si es para todos los dientes
    };

    console.log("Datos enviados al servidor:", cotizacionData);

    fetch("/api/admin/cotizaciones", {
        method: "POST",
        headers: {
            "Content-Type": "application/json",
        },
        body: JSON.stringify(cotizacionData),
    })
        .then((response) => {
            if (!response.ok) {
                throw new Error(`Error: ${response.statusText}`);
            }
            return response.json();
        })
        .then((data) => {
            console.log("Cotización guardada con éxito:", data);
            showUiMessage("Cotización guardada correctamente.", 'success');
        })
        .catch((error) => {
            console.error("Error al guardar la cotización:", error);
            showUiMessage("Ocurrió un error al guardar la cotización.", 'danger');
        });
}


    
        /**
     * Validar los campos del formulario.
     */
    function validateFormInputs() {
        const paciente = $("#paciente").val();
        const tipoServicio = $("#tipoServicio").val();
        const buscarServicio = $("#buscarServicio").val();
        const costoServicio = parseFloat($("#costoServicio").val());

        if (!paciente || paciente === "") {
            showUiMessage("Por favor, seleccione un paciente.", 'warning');
            return false;
        }
        if (!tipoServicio || tipoServicio === "") {
            showUiMessage("Por favor, seleccione un tipo de servicio.", 'warning');
            return false;
        }
        if (!buscarServicio || buscarServicio === "") {
            showUiMessage("Por favor, seleccione un servicio.", 'warning');
            return false;
        }
        if (isNaN(costoServicio) || costoServicio <= 0) {
            showUiMessage("El costo del servicio debe ser un valor positivo.", 'warning');
            return false;
        }
        return true;
    }

    /**
     * Actualizar la tabla de cotizaciones sin recargar la página.
     */
     function updateTable(data) {
        const tableBody = $("#cotizacionTable tbody");
        tableBody.empty();

        data.forEach(item => {
            const row = `
                <tr>
                    <td>${item.diente || "N/A"}</td>
                    <td>${item.nombre_tratamiento || "N/A"}</td>
                    <td>${item.nombre_servicio || "N/A"}</td>
                    <td>${item.notas || "Sin notas"}</td>
                    
                </tr>`;
            tableBody.append(row);
        });

        initializeDataTable(); // Reinicializar DataTables
    }

    function calculateTotalSum() {
    let totalSum = 0;

    // Itera sobre las filas con subtotales
    $("#cotizacionTable tbody tr.table-primary").each(function () {
        const subtotalText = $(this).find("td:last").text(); // Obtiene el texto del subtotal
        const subtotal = parseFloat(subtotalText.replace("Q", "").trim()); // Convierte a número
        if (!isNaN(subtotal)) {
            totalSum += subtotal;
        }
    });

    // Actualiza el Total General en el DOM
    $("#totalGeneralValue").text(`Q${totalSum.toFixed(2)}`);
}


    /**
     * Abrir el modal de tratamientos y limpiar valores previos.
     */
     function openTreatmentModalForAll() {
    // Indicar que el tratamiento es para todos los dientes
    selectedTeeth = "1-32";

    $("#treatmentModalLabel").text("Agregar Tratamiento para Todos los Dientes");
    $("#paciente").val(""); // Limpia el valor del select
    $("#notas").val("Aplicar tratamiento a todos los dientes (1-32)");

    console.log("Tratamiento para todos los dientes, rango:", selectedTeeth);
    $("#treatmentModal").modal("show");
}


    /**
     * Abrir el modal para dientes seleccionados.
     */
    function openTreatmentModalForSelection() {
        if (selectedTeeth.length === 0) {
            showUiMessage("Por favor, seleccione al menos un diente antes de continuar.", 'warning');
            return;
        }

        $("#treatmentModalLabel").text(`Agregar Tratamiento para los Dientes: ${selectedTeeth.join(", ")}`);
        $("#paciente").val(""); // Limpia el valor del select
        $("#notas").val(`Aplicar tratamiento a los dientes seleccionados: ${selectedTeeth.join(", ")}`);
        $("#treatmentModal").modal("show");
    }
    
        /**
         * Generar PDF con la información de tratamientos.
         */
         $('#saveTable').on('click', function () {
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();

    const tableRows = document.querySelectorAll("#cotizacionTable tbody tr");
    if (tableRows.length === 0) {
        showUiMessage("No hay datos en la tabla para generar el PDF.", 'warning');
        return;
    }

    const tableData = [];
    Array.from(tableRows).forEach((row) => {
        const cells = row.querySelectorAll("td");
        const isSubtotalRow = row.classList.contains("subtotal-row");
        
        if (isSubtotalRow) {
            tableData.push({
                diente: "",
                tratamiento: "",
                servicio: "",
                notas: "Subtotal",
                subtotal: cells[4]?.innerText || "N/A",
                isSubtotal: true,
            });
        } else {
            tableData.push({
                diente: cells[0]?.innerText || "N/A",
                tratamiento: cells[1]?.innerText || "N/A",
                servicio: cells[2]?.innerText || "N/A",
                notas: cells[3]?.innerText || "Sin notas",
                subtotal: "",
                isSubtotal: false,
            });
        }
    });

    doc.setFontSize(18);
    doc.text("Listado de Tratamientos", 10, 10);

    const tableHeader = ["Diente", "Tratamiento", "Servicio", "Notas", "Subtotal"];
    const pdfTableData = tableData.map((item) => [
        item.diente,
        item.tratamiento,
        item.servicio,
        item.notas,
        item.isSubtotal ? item.subtotal : "",
    ]);

    doc.autoTable({
        head: [tableHeader],
        body: pdfTableData,
        startY: 20,
        theme: "grid",
        headStyles: { fillColor: [0, 150, 136], textColor: 255, fontSize: 12 },
        bodyStyles: (row, colIndex) => {
            if (pdfTableData[row][4]) {
                return { fontStyle: "bold", fillColor: [240, 240, 240] }; // Estilo para subtotales
            }
            return {};
        },
        alternateRowStyles: { fillColor: [250, 250, 250] },
    });

    const fileName = `Tratamientos_${new Date().toISOString().split("T")[0]}.pdf`;
    doc.save(fileName);
});







    </script>
    <script>
        window.initSearchableNativeSelect?.('paciente', 'quotePatientSearch', {
            placeholder: 'Seleccionar paciente',
            searchPlaceholder: 'Buscar paciente',
        });
        window.initSearchableNativeSelect?.('tipoServicio', 'quoteTreatmentSearch', {
            placeholder: 'Seleccionar tipo de servicio',
            searchPlaceholder: 'Buscar tratamiento',
        });
        window.initSearchableNativeSelect?.('buscarServicio', 'quoteServiceSearch', {
            placeholder: 'Seleccionar servicio',
            searchPlaceholder: 'Buscar servicio',
        });
    </script>
<%- include('partials/uiFeedback') %>
           

