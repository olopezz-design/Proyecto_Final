    <style>
        /* Estilo de paginación */
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            color: #007bff;
            background-color: transparent;
            border: none;
            padding: 0;
            margin: 0 5px;
            font-size: 14px;
            cursor: pointer;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            font-weight: bold;
            color: white;
            background-color: #007bff;
            border-radius: 4px;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            color: white;
            background-color: #0056b3;
            border-radius: 4px;
        }
        
        /* Ocultar filtro por defecto */
        .dataTables_filter {
            display: none;
        }

        /* Ajustes generales */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
        }
        #page-content-wrapper {
            flex: 1;
        }
        footer {
            position: relative;
            bottom: 0;
            width: 100%;
            background-color: #343a40;
            color: white;
            text-align: center;
            padding: 10px 0;
        }
        .modal-body {
            max-height: 400px;
            overflow-y: auto;
        }
        
        /* Estilo personalizado de la tabla */
        .table-striped tbody tr:nth-of-type(odd) {
            background-color: rgba(0, 0, 0, .05);
        }
        .table thead th {
            background-color: #343a40;
            color: white;
            text-align: center;
            font-weight: bold;
        }
        .table tbody td {
            vertical-align: middle;
            text-align: center;
        }
        .btn-sm {
            font-size: 0.875rem;
            padding: 0.25rem 0.5rem;
        }

        .btn-success {
            background-color: #28a745;
            border-color: #28a745;
            color: white;
            font-weight: bold;
        }

        .btn-success:hover {
            background-color: #218838;
            border-color: #1e7e34;
        }

        .dental-chart-container {
            padding: 20px;
            width: 100%;
            overflow-x: auto; /* Permitir desplazamiento horizontal si es necesario */
        }

        .dental-chart {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        .dental-row {
            display: flex;
            justify-content: center;
            gap: 0px; /* Aumentar espacio entre dientes */
        }

        .tooth {
            cursor: pointer;
            transition: transform 0.3s ease, fill 0.3s ease;
        }

        .tooth:hover {
            transform: scale(1.2);
            fill: #007bff; /* Color al pasar el cursor */
        }

        .tooth.selected {
            fill: #28a745; /* Color cuando se selecciona */
            stroke: #000;
            stroke-width: 2px;
        }

        /* Contenedor para cada diente y su etiqueta */
        .tooth-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 5px; /* Espacio entre el diente y la etiqueta */
        }

        /* Etiquetas estilizadas */
        .tooth-label {
            font-size: 14px; /* Tamaño ajustado */
            color: #333; /* Color consistente con la aplicación */
            font-weight: bold;
            text-align: center;
            user-select: none; /* Evitar que se seleccionen al hacer clic */
        }

        /* Dientes no seleccionados: gris claro */
        .tooth path {
            fill: #e0e0e0; /* Gris claro para dientes no seleccionados */
            transition: fill 0.3s ease, transform 0.3s ease;
        }

        /* Hover: Azul más intenso */
        .tooth:hover path {
            fill: #0056b3; /* Azul oscuro al pasar el cursor */
            transform: scale(1.1); /* Efecto de agrandamiento */
        }

        /* Dientes seleccionados: Azul */
        .tooth.selected path {
            fill: #28a745; /* Green color for selected teeth */
            stroke: #28a745;
            stroke-width: 2px;
        }

        /* Dientes con opciones positivas: Verde */
        .tooth.positive path {
            fill: #28a745; /* Verde suave para opciones positivas */
            stroke: #1e7e34; /* Contorno verde oscuro */
            stroke-width: 2px;
        }

    </style>
    <%- include('partials/searchableSelect') %>
</head>
