<%
  const headerProfile = typeof adminProfile !== 'undefined' ? adminProfile : {};
  const headerName = headerProfile.displayName || 'Nombre pendiente';
  const headerInitials = headerProfile.initials || headerName.split(/\s+/).slice(0, 2).map(part => part.charAt(0).toUpperCase()).join('') || 'DR';
  const headerPhoto = headerProfile.photoUrl || '';
  const headerRole = headerProfile.roleLabel || 'Usuario';
  const canFn = typeof can === 'function' ? can : () => true;
  const p = paciente || {};
  const citasList = Array.isArray(citas) ? citas : [];
  const historyList = Array.isArray(historial) ? historial : [];
  const latestTreatment = typeof recentTreatment !== 'undefined' ? recentTreatment : null;
  const patientFileList = Array.isArray(patientFiles) ? patientFiles : [];
  const flags = Array.isArray(medicalFlags) ? medicalFlags : [];
  const fichaDetalles = p.fichaDetalles || {};
  const detalleLabels = {
    enfermedad_corazon: 'Padece de alguna enfermedad del corazón',
    presion_alta_baja: 'Padece de presión alta o baja',
    diabetico: 'Es diabético/a',
    operaciones_recientes: 'Ha tenido operaciones en los últimos 6 meses',
    hepatitis: 'Ha tenido hepatitis',
    enfermedad_higado_rinones: 'Padece de alguna enfermedad de los riñones o hígado',
    convulsiones_desmayos: 'Sufre de convulsiones o desmayos',
    enfermedad_transmision_sexual: 'Ha tenido o tiene alguna enfermedad de transmisión sexual',
    alergias: 'Padece de alergias',
    enfermedad_respiratoria: 'Padece de alguna enfermedad respiratoria',
    embarazada: 'Se encuentra embarazada',
    hemorragias_espontaneas: 'Sufre de hemorragias espontáneas',
    enfermedad_no_mencionada: 'Padece de alguna enfermedad no mencionada anteriormente',
    alergia_material_odontologico: 'Es alérgico/a a algún material odontológico',
    alergia_medicamento: 'Es alérgico/a a algún medicamento',
    aftas: 'Tiene fuegos o aftas dentro o fuera de la boca',
    dolor_dental: 'Tiene dolor dental',
    sensibilidad: 'Tiene sensibilidad dental'
  };
  const fullName = `${p.nombre || ''} ${p.apellido || ''}`.trim() || 'Paciente';
  const patientInitials = fullName.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0].toUpperCase()).join('') || 'P';
  const formatDate = value => {
    if (!value) return 'Sin registro';
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? 'Sin registro' : date.toLocaleDateString('es-GT');
  };
  const formatTime = value => String(value || '').slice(0, 5) || '--:--';
  const getCitaDateTime = cita => {
    if (!cita?.fechaCita) return null;
    const date = new Date(cita.fechaCita);
    if (Number.isNaN(date.getTime())) return null;
    const [hours = 0, minutes = 0] = String(cita.horaCita || '').split(':').map(Number);
    date.setHours(Number.isFinite(hours) ? hours : 0, Number.isFinite(minutes) ? minutes : 0, 0, 0);
    return date;
  };
  const datedCitas = citasList
    .map(cita => ({ cita, date: getCitaDateTime(cita) }))
    .filter(item => item.date);
  const now = new Date();
  const closedStatus = cita => ['finalizada', 'atendida'].includes(String(cita?.estado_cita || cita?.consulta_activa_estado || '').toLowerCase());
  const canceledStatus = cita => String(cita?.estado_cita || '').toLowerCase() === 'cancelada';
  const recentVisit = datedCitas
    .filter(item => !canceledStatus(item.cita) && (closedStatus(item.cita) || item.date <= now))
    .sort((a, b) => {
      const aDate = a.cita.finalized_at ? new Date(a.cita.finalized_at) : a.date;
      const bDate = b.cita.finalized_at ? new Date(b.cita.finalized_at) : b.date;
      return bDate - aDate;
    })[0]?.cita || null;
  const upcomingVisit = datedCitas
    .filter(item => item.date > now && !closedStatus(item.cita) && !canceledStatus(item.cita))
    .sort((a, b) => a.date - b.date)[0]?.cita || null;
  const nextClinicalDate = historyList
    .map(item => item.proximaCita)
    .filter(Boolean)
    .map(value => new Date(value))
    .filter(date => !Number.isNaN(date.getTime()) && date > now)
    .sort((a, b) => a - b)[0] || null;
  const formatVisit = cita => cita ? `${formatDate(cita.finalized_at || cita.fechaCita)} ${cita.finalized_at ? '' : formatTime(cita.horaCita)}`.trim() : 'Sin registro';
  const formatNextVisit = cita => cita ? `${formatDate(cita.fechaCita)} ${formatTime(cita.horaCita)}` : (nextClinicalDate ? formatDate(nextClinicalDate) : 'Sin registro');
  const fileCategory = file => {
    const ruta = String(file.ruta || '').toLowerCase();
    if (ruta.includes('/recetas/')) return 'Recetas';
    if (ruta.includes('/cotizaciones/')) return 'Cotizaciones';
    return 'Archivos subidos';
  };
%>
<!DOCTYPE html>
<html lang="es">
  <head>
    <base href="/" />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= fullName %> - C&C Dental Studio</title>
    <link rel="shortcut icon" type="image/svg+xml" href="/images/cnc-favicon.svg">
    <link rel="stylesheet" href="assets/fonts/remix/remixicon.css">
    <link rel="stylesheet" href="assets/css/main.min.css">
    <link rel="stylesheet" href="assets/vendor/overlay-scroll/OverlayScrollbars.min.css">
    <link rel="stylesheet" href="assets/vendor/daterange/daterange.css">
    <style>
      .header-actions > .d-lg-flex.d-none.gap-2 { display: none !important; }
      .profile-initials-badge,
      .patient-photo {
        align-items: center;
        background: #f4f1ff;
        color: #705df3;
        display: inline-flex;
        font-weight: 800;
        justify-content: center;
      }
      .patient-photo {
        border: 2px solid #705df3;
        border-radius: 50%;
        flex: 0 0 112px;
        font-size: 2rem;
        height: 112px;
        width: 112px;
      }
      .patient-summary-stat h4 {
        line-height: 1.15;
        max-width: 240px;
      }
      .metric-pill {
        align-items: center;
        border: 1px solid #dde2ee;
        border-radius: 18px;
        display: flex;
        gap: .8rem;
        padding: .9rem 1rem;
      }
      .metric-pill i {
        align-items: center;
        background: #f4f1ff;
        border-radius: 50%;
        color: #705df3;
        display: inline-flex;
        font-size: 1.3rem;
        height: 42px;
        justify-content: center;
        width: 42px;
      }
      .clinical-chip {
        border-radius: 999px;
        display: inline-flex;
        margin: 0 .35rem .5rem 0;
        padding: .45rem .75rem;
      }
      .timeline-item {
        border-left: 3px solid #705df3;
        padding-left: 1rem;
        position: relative;
      }
      .timeline-item:before {
        background: #705df3;
        border-radius: 50%;
        content: "";
        height: 12px;
        left: -7px;
        position: absolute;
        top: .35rem;
        width: 12px;
      }
      .visit-review {
        border: 1px solid #dde2ee;
        border-radius: 8px;
        overflow: hidden;
      }
      .visit-review-header {
        background: #7367f0;
        color: #fff;
        display: grid;
        gap: 1rem;
        grid-template-columns: 1.4fr 1fr 1fr 1fr;
        padding: .8rem 1rem;
      }
      .visit-review-body {
        padding: 1rem;
      }
      .file-mini-card {
        align-items: center;
        border: 1px solid #dde2ee;
        border-radius: 8px;
        display: flex;
        gap: .75rem;
        padding: .75rem;
      }
      @media (max-width: 767.98px) {
        .visit-review-header {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="page-wrapper">
      <div class="main-container">
        <nav id="sidebar" class="sidebar-wrapper">
          <div class="brand-container d-flex align-items-center justify-content-between">
            <div class="app-brand ms-3">
              <a href="/admin/dash"><img src="/images/cnc-logo-alt.svg" class="logo" alt="C&C Dental Studio"></a>
            </div>
            <button type="button" class="pin-sidebar me-3"><i class="ri-menu-line"></i></button>
          </div>
          <div class="sidebar-profile">
            <% if (headerPhoto) { %>
              <img src="<%= headerPhoto %>" class="rounded-5 border border-primary border-3" alt="Foto de perfil">
            <% } else { %>
              <span class="profile-initials-badge rounded-5 border border-primary border-3 img-4x"><%= headerInitials %></span>
            <% } %>
            <h6 class="mb-1 profile-name text-nowrap text-truncate text-primary"><%= headerName %></h6>
            <small class="profile-name text-nowrap text-truncate"><%= headerRole %></small>
          </div>
          <div class="sidebarMenuScroll">
            <%- include('partials/adminSidebar', { activePage: 'pacientes', canFn }) %>
          </div>
        </nav>

        <div class="app-container">
          <div class="app-header d-flex align-items-center">
            <div class="d-flex">
              <div class="search-container d-xl-block d-none">
                <input type="text" class="form-control" placeholder="Buscar">
                <i class="ri-search-line"></i>
              </div>
            </div>
            <div class="header-actions ms-auto d-flex align-items-center gap-2">
              <button type="button" class="btn btn-icon btn-light rounded-5"><i class="ri-star-line"></i></button>
              <button type="button" class="btn btn-icon btn-light rounded-5"><i class="ri-notification-3-line"></i></button>
              <div class="dropdown ms-3">
                <a id="userSettings" class="dropdown-toggle d-flex align-items-center" href="#!" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <div class="avatar-box">
                    <% if (headerPhoto) { %>
                      <img src="<%= headerPhoto %>" class="img-2xx rounded-5 border border-3 border-white" alt="Foto de perfil">
                    <% } else { %>
                      <span class="profile-initials-badge img-2xx rounded-5 border border-3 border-white"><%= headerInitials %></span>
                    <% } %>
                    <span class="status busy"></span>
                  </div>
                </a>
                <div class="dropdown-menu dropdown-menu-end shadow-lg">
                  <div class="px-3 py-2">
                    <span class="small"><%= headerRole %></span>
                    <h6 class="m-0"><%= headerName %></h6>
                  </div>
                  <div class="dropdown-divider"></div>
                  <a href="/admin/perfil" class="dropdown-item"><i class="ri-user-line me-2"></i> Perfil</a>
                  <a href="/admin/settings" class="dropdown-item"><i class="ri-settings-3-line me-2"></i> Configuración</a>
                  <div class="dropdown-divider"></div>
                  <div class="mx-3 my-2 d-grid"><a href="/logout" class="btn btn-danger">Cerrar sesión</a></div>
                </div>
              </div>
            </div>
          </div>

          <div class="app-hero-header d-flex align-items-center">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/admin/dash"><i class="ri-home-3-line"></i></a></li>
              <li class="breadcrumb-item"><a href="/admin/pacientes">Pacientes</a></li>
              <li class="breadcrumb-item text-primary" aria-current="page">Ficha del paciente</li>
            </ol>
            <div class="ms-auto">
              <input type="text" id="abc" class="form-control custom-daterange">
            </div>
          </div>

          <div class="app-body">
            <div class="row gx-4">
              <div class="col-sm-12">
                <div class="card mb-4">
                  <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center gap-4">
                      <div class="d-flex align-items-center flex-wrap gap-4 flex-grow-1">
                        <div class="d-flex align-items-center patient-summary-stat">
                          <div class="icon-box lg bg-primary-subtle rounded-5 me-2">
                            <i class="ri-account-circle-line fs-3 text-primary"></i>
                          </div>
                          <div>
                            <h4 class="mb-1 text-truncate"><%= fullName %></h4>
                            <p class="m-0">Nombre</p>
                          </div>
                        </div>
                        <div class="d-flex align-items-center patient-summary-stat">
                          <div class="icon-box lg bg-primary-subtle rounded-5 me-2">
                            <i class="ri-user-heart-line fs-3 text-primary"></i>
                          </div>
                          <div>
                            <h4 class="mb-1"><%= p.genero_nombre || 'N/D' %></h4>
                            <p class="m-0">Género</p>
                          </div>
                        </div>
                        <div class="d-flex align-items-center patient-summary-stat">
                          <div class="icon-box lg bg-primary-subtle rounded-5 me-2">
                            <i class="ri-arrow-right-up-line fs-3 text-primary"></i>
                          </div>
                          <div>
                            <h4 class="mb-1"><%= p.edad ?? 'N/D' %></h4>
                            <p class="m-0">Edad</p>
                          </div>
                        </div>
                        <div class="d-flex align-items-center patient-summary-stat">
                          <div class="icon-box lg bg-primary-subtle rounded-5 me-2">
                            <i class="ri-contrast-drop-2-line fs-3 text-primary"></i>
                          </div>
                          <div>
                            <h4 class="mb-1"><%= p.tipoSangre || 'N/D' %></h4>
                            <p class="m-0">Tipo de sangre</p>
                          </div>
                        </div>
                      </div>
                      <span class="patient-photo ms-xl-auto"><%= patientInitials %></span>
                    </div>
                  </div>
                  <div class="card-footer">
                    <div class="d-flex flex-row flex-wrap align-items-center gap-3">
                      <div class="d-flex align-items-center">
                        <div class="icon-box sm bg-primary-subtle rounded-5 me-2">
                          <i class="ri-stethoscope-line fs-5 text-primary"></i>
                        </div>
                        <div>
                          Tipo: <span class="text-primary"><%= p.tipo_paciente || 'Pendiente' %></span>
                        </div>
                      </div>
                      <div class="d-flex align-items-center">
                        <div class="icon-box sm bg-primary-subtle rounded-5 me-2">
                          <i class="ri-building-2-line fs-5 text-primary"></i>
                        </div>
                        <div>
                          Cita reciente: <span class="text-primary"><%= formatVisit(recentVisit) %></span>
                        </div>
                      </div>
                      <div class="d-flex align-items-center">
                        <div class="icon-box sm bg-primary-subtle rounded-5 me-2">
                          <i class="ri-calendar-2-line fs-5 text-primary"></i>
                        </div>
                        <div>
                          Próxima cita: <span class="text-primary"><%= formatNextVisit(upcomingVisit) %></span>
                        </div>
                      </div>
                      <a href="/admin/pacientes" class="btn btn-secondary ms-xl-auto">Volver al listado</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="row gx-4">
              <div class="col-xl-8 col-12">
                <div class="card mb-4">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Información del paciente</h5>
                  </div>
                  <div class="card-body">
                    <div class="row g-3">
                      <div class="col-md-4"><div class="metric-pill"><i class="ri-men-line"></i><div><p class="m-0 text-muted">Género</p><strong><%= p.genero_nombre || 'N/D' %></strong></div></div></div>
                      <div class="col-md-4"><div class="metric-pill"><i class="ri-calendar-line"></i><div><p class="m-0 text-muted">Edad</p><strong><%= p.edad || 'N/D' %></strong></div></div></div>
                      <div class="col-md-4"><div class="metric-pill"><i class="ri-drop-line"></i><div><p class="m-0 text-muted">Sangre</p><strong><%= p.tipoSangre || 'N/D' %></strong></div></div></div>
                      <div class="col-md-6"><div class="metric-pill"><i class="ri-phone-line"></i><div><p class="m-0 text-muted">Teléfono</p><strong><%= p.telefono || '-' %></strong></div></div></div>
                      <div class="col-md-6"><div class="metric-pill"><i class="ri-mail-line"></i><div><p class="m-0 text-muted">Correo</p><strong><%= p.email || '-' %></strong></div></div></div>
                      <div class="col-md-6"><div class="metric-pill"><i class="ri-id-card-line"></i><div><p class="m-0 text-muted">DPI / NIT</p><strong><%= p.dpi || '-' %> / <%= p.nit || '-' %></strong></div></div></div>
                      <div class="col-md-6"><div class="metric-pill"><i class="ri-cake-2-line"></i><div><p class="m-0 text-muted">Nacimiento</p><strong><%= formatDate(p.fechaNacimiento) %></strong></div></div></div>
                      <div class="col-12"><div class="metric-pill"><i class="ri-map-pin-line"></i><div><p class="m-0 text-muted">Dirección</p><strong><%= p.direccion || 'Sin dirección registrada' %></strong></div></div></div>
                    </div>
                  </div>
                </div>

                <div class="card mb-4">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Historial de tratamientos</h5>
                  </div>
                  <div class="card-body">
                    <% if (latestTreatment) { %>
                      <div class="visit-review mb-4">
                        <div class="visit-review-header">
                          <div>
                            <small class="d-block opacity-75">Doctor</small>
                            <strong>Dr. <%= `${latestTreatment.doctor_nombre || ''} ${latestTreatment.doctor_apellido || ''}`.trim() || 'No asignado' %></strong>
                          </div>
                          <div>
                            <small class="d-block opacity-75">Fecha</small>
                            <strong><%= formatDate(latestTreatment.finalized_at || latestTreatment.fechaCita) %></strong>
                          </div>
                          <div>
                            <small class="d-block opacity-75">Motivo</small>
                            <strong><%= latestTreatment.motivoConsulta || latestTreatment.motivoCita || 'Consulta' %></strong>
                          </div>
                          <div>
                            <small class="d-block opacity-75">Documentos</small>
                            <strong><%= (latestTreatment.archivos || []).length + (latestTreatment.cotizaciones || []).length %></strong>
                          </div>
                        </div>
                        <div class="visit-review-body">
                          <div class="mb-3">
                            <h6>Resumen clínico</h6>
                            <p class="mb-1"><strong>Diagnóstico:</strong> <%= latestTreatment.diagnosticoPrincipal || 'Sin diagnóstico registrado' %></p>
                            <p class="mb-1"><strong>Tratamiento:</strong> <%= latestTreatment.tratamiento || 'Sin tratamiento registrado' %></p>
                            <p class="mb-0"><strong>Observaciones:</strong> <%= latestTreatment.observaciones || 'Sin observaciones registradas' %></p>
                          </div>

                          <div class="mb-3">
                            <h6>Medicamentos</h6>
                            <% if (!(latestTreatment.medicamentos || []).length) { %>
                              <p class="text-muted mb-0">Sin medicamentos registrados.</p>
                            <% } %>
                            <div class="row gx-3">
                              <% (latestTreatment.medicamentos || []).forEach(med => { %>
                                <div class="col-md-6 col-12 mb-2">
                                  <div class="border rounded-3 p-3 h-100">
                                    <strong><%= med.nombre %></strong>
                                    <div class="small text-muted mt-1">
                                      Dosis: <%= med.dosis || 'N/D' %> · Frecuencia: <%= med.frecuencia || 'N/D' %> · Duración: <%= med.duracion || 'N/D' %>
                                    </div>
                                  </div>
                                </div>
                              <% }) %>
                            </div>
                          </div>

                          <div class="row gx-3">
                            <div class="col-md-6 col-12">
                              <h6>Archivos</h6>
                              <% if (!(latestTreatment.archivos || []).length) { %>
                                <p class="text-muted">Sin archivos adjuntos.</p>
                              <% } %>
                              <div class="d-grid gap-2">
                                <% (latestTreatment.archivos || []).slice(0, 4).forEach(file => { %>
                                  <a href="<%= file.ruta %>" target="_blank" class="file-mini-card text-decoration-none">
                                    <i class="<%= String(file.mime_type || '').includes('pdf') ? 'ri-file-pdf-2-line' : 'ri-image-line' %> fs-4 text-primary"></i>
                                    <span class="text-truncate"><%= file.nombre_original %></span>
                                  </a>
                                <% }) %>
                              </div>
                            </div>
                            <div class="col-md-6 col-12">
                              <h6>Cotizaciones</h6>
                              <% if (!(latestTreatment.cotizaciones || []).length) { %>
                                <p class="text-muted">Sin cotizaciones registradas.</p>
                              <% } %>
                              <div class="d-grid gap-2">
                                <% (latestTreatment.cotizaciones || []).slice(0, 4).forEach(quote => { %>
                                  <a href="/admin/consultas/activas/<%= latestTreatment.idconsultaActiva %>/cotizaciones/<%= quote.id_cotizacion %>/documento" target="_blank" class="file-mini-card text-decoration-none">
                                    <i class="ri-file-list-3-line fs-4 text-primary"></i>
                                    <span>Cotización · Q<%= Number(quote.costo_total || 0).toFixed(2) %></span>
                                  </a>
                                <% }) %>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                    <% } %>
                    <% if (!historyList.length) { %>
                      <p class="text-muted mb-0">Este paciente aún no tiene tratamientos registrados.</p>
                    <% } %>
                    <div class="d-grid gap-3">
                      <% historyList.forEach(item => { %>
                        <div class="timeline-item">
                          <div class="d-flex flex-wrap justify-content-between gap-2">
                            <h6 class="mb-1"><%= item.servicio_nombre || 'Tratamiento' %></h6>
                            <span class="text-muted small"><%= formatDate(item.fecharegistro) %></span>
                          </div>
                          <p class="mb-1"><%= item.descripcion %></p>
                          <small class="text-muted">
                            Doctor: <%= `${item.doctor_nombre || ''} ${item.doctor_apellido || ''}`.trim() || 'No asignado' %>
                            · Pieza: <%= item.nopieza || 'N/D' %>
                            · Próxima cita: <%= formatDate(item.proximaCita) %>
                          </small>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-xl-4 col-12">
                <div class="card mb-4">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Ficha médica</h5>
                  </div>
                  <div class="card-body">
                    <% if (!flags.length) { %>
                      <p class="text-muted mb-3">Sin alertas médicas marcadas.</p>
                    <% } else { %>
                      <% flags.forEach(flag => { %>
                        <span class="clinical-chip bg-danger-subtle text-danger"><%= flag %></span>
                      <% }) %>
                    <% } %>
                    <% if (Object.keys(fichaDetalles).length) { %>
                      <div class="mt-3">
                        <% Object.keys(fichaDetalles).forEach(key => { %>
                          <div class="border rounded-3 p-2 mb-2">
                            <small class="text-muted d-block"><%= detalleLabels[key] || key.replace(/_/g, ' ') %></small>
                            <span><%= fichaDetalles[key] %></span>
                          </div>
                        <% }) %>
                      </div>
                    <% } %>
                    <hr>
                    <p class="text-muted mb-1">Última visita al dentista</p>
                    <p><%= p.ultima_visita_dentista || 'Sin registro' %></p>
                    <p class="text-muted mb-1">Tratamiento realizado</p>
                    <p class="mb-0"><%= p.tratamiento_realizado || 'Sin registro' %></p>
                  </div>
                </div>

                <div class="card mb-4">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Contacto de emergencia</h5>
                  </div>
                  <div class="card-body">
                    <p class="mb-1"><strong><%= p.emergencia_nombre || 'Sin contacto registrado' %></strong></p>
                    <p class="text-muted mb-1"><%= p.emergencia_parentesco || '-' %></p>
                    <p class="mb-0"><i class="ri-phone-line me-1"></i><%= p.emergencia_numero || '-' %></p>
                  </div>
                </div>

                <div class="card mb-4">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Archivos del paciente</h5>
                  </div>
                  <div class="card-body">
                    <% if (!patientFileList.length) { %>
                      <p class="text-muted mb-0">Sin archivos guardados todavía.</p>
                    <% } %>
                    <div class="d-grid gap-2">
                      <% patientFileList.slice(0, 8).forEach(file => { %>
                        <a href="<%= file.ruta %>" target="_blank" class="file-mini-card text-decoration-none">
                          <i class="<%= String(file.mime_type || '').includes('pdf') ? 'ri-file-pdf-2-line' : 'ri-image-line' %> fs-4 text-primary"></i>
                          <div class="min-w-0">
                            <div class="text-truncate"><%= file.nombre_original %></div>
                            <small class="text-muted"><%= fileCategory(file) %> · <%= formatDate(file.created_at) %></small>
                          </div>
                        </a>
                      <% }) %>
                    </div>
                  </div>
                </div>

                <div class="card mb-4">
                  <div class="card-header">
                    <h5 class="card-title mb-0">Citas del paciente</h5>
                  </div>
                  <div class="card-body">
                    <% if (!citasList.length) { %>
                      <p class="text-muted mb-0">Sin citas registradas.</p>
                    <% } %>
                    <div class="d-grid gap-2">
                      <% citasList.forEach(cita => { %>
                        <div class="border rounded-3 p-3">
                          <div class="d-flex justify-content-between gap-2">
                            <strong><%= formatDate(cita.fechaCita) %></strong>
                            <span class="badge bg-primary-subtle text-primary"><%= formatTime(cita.horaCita) %></span>
                          </div>
                          <p class="mb-1 mt-2"><%= cita.motivoCita %></p>
                          <small class="text-muted">
                            <%= cita.estado_cita || 'Sin estado' %> · Dr. <%= `${cita.doctor_nombre || ''} ${cita.doctor_apellido || ''}`.trim() || 'No asignado' %>
                          </small>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="app-footer"><span>© C&C Dental Studio 2026</span></div>
        </div>
      </div>
    </div>
    <script src="assets/js/jquery.min.js"></script>
    <script src="assets/js/bootstrap.bundle.min.js"></script>
    <script src="assets/vendor/overlay-scroll/jquery.overlayScrollbars.min.js"></script>
    <script src="assets/vendor/overlay-scroll/custom-scrollbar.js"></script>
    <script src="assets/vendor/daterange/daterange.js"></script>
    <script src="assets/vendor/daterange/custom-daterange.js"></script>
    <script src="assets/js/custom.js"></script>
  </body>
</html>
