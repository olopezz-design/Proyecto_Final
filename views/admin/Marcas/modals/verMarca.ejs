<!-- Modal para ver la información de la marca -->
<div class="modal fade" id="verMarcaModal" tabindex="-1" aria-labelledby="verMarcaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="verMarcaModalLabel">Información de la Marca</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Mostrar los detalles de la marca en filas -->
                <div class="row mb-3">
                    <div class="col-4 font-weight-bold">ID:</div>
                    <div class="col-8" id="idMarcaInfo"></div>
                </div>
                <div class="row mb-3">
                    <div class="col-4 font-weight-bold">Nombre:</div>
                    <div class="col-8" id="nombreMarcaInfo"></div>
                </div>
                <div class="row mb-3">
                    <div class="col-4 font-weight-bold">Descripción:</div>
                    <div class="col-8" id="descripcionMarcaInfo"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
