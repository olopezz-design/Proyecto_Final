<!DOCTYPE html>
<html lang="es">
<%
  const headerProfile = typeof adminProfile !== 'undefined' ? adminProfile : {};
  const headerName = headerProfile.displayName || 'Nombre pendiente';
  const headerInitials = headerProfile.initials || headerName.split(/\s+/).slice(0, 2).map(part => part.charAt(0).toUpperCase()).join('') || 'DR';
  const headerPhoto = headerProfile.photoUrl || '';
  const headerRole = headerProfile.roleLabel || 'Usuario';
  const canFn = typeof can === 'function' ? can : () => true;
%>

  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title || 'Configuración' %> - C&C Dental Studio</title>

    <!-- Meta -->
    <meta name="description" content="Marketplace for Bootstrap Admin Dashboards">
    <meta property="og:title" content="Admin Templates - Dashboard Templates">
    <meta property="og:description" content="Marketplace for Bootstrap Admin Dashboards">
    <meta property="og:type" content="Website">
    <link rel="shortcut icon" type="image/svg+xml" href="/images/cnc-favicon.svg">

    <!-- *************
		************ CSS Files *************
	  ************* -->
    <link rel="stylesheet" href="assets/fonts/remix/remixicon.css">
    <link rel="stylesheet" href="assets/css/main.min.css">

    <!-- *************
		************ Vendor Css Files *************
	  ************ -->

    <!-- Scrollbar CSS -->
    <link rel="stylesheet" href="assets/vendor/overlay-scroll/OverlayScrollbars.min.css">

    <!-- Date Range CSS -->
    <link rel="stylesheet" href="assets/vendor/daterange/daterange.css">

    <style>
      .header-actions > .d-lg-flex.d-none.gap-2 {
        display: none !important;
      }

      .profile-initials-badge {
        align-items: center;
        background: #f4f1ff;
        color: #705df3;
        display: inline-flex;
        font-weight: 800;
        justify-content: center;
      }

      .settings-status {
        display: none;
      }

      .catalog-grid {
        display: grid;
        grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
        gap: 1rem;
      }

      .app-container,
      .catalog-grid > section,
      .settings-card-soft {
        min-width: 0;
      }

      .catalog-list {
        max-height: 520px;
        overflow-y: auto;
      }

      .catalog-list .list-group-item {
        border-radius: 12px;
        margin-bottom: .5rem;
        border: 1px solid var(--bs-border-color);
      }

      .catalog-list .list-group-item.active {
        background: linear-gradient(135deg, #0d6efd, #18a4bc);
        border-color: transparent;
      }

      .catalog-empty-state {
        border: 1px dashed #b6c7d8;
        border-radius: 16px;
        padding: 1.4rem;
        text-align: center;
        color: #6c757d;
        background: #f8fbff;
      }

      .catalog-form-card,
      .settings-card-soft {
        border: 1px solid rgba(13, 110, 253, .12);
        border-radius: 18px;
        background: linear-gradient(180deg, rgba(248, 251, 255, .98), rgba(255, 255, 255, .96));
      }

      .settings-kicker {
        color: #0d6efd;
        font-size: .76rem;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
      }

      .config-table-actions {
        min-width: 160px;
      }

      .table-outer {
        border: 1px solid #dde2ee;
        border-radius: 8px;
        max-width: 100%;
        overflow: hidden;
      }

      .table-outer .table-responsive {
        max-width: 100%;
      }

      .table-outer table {
        min-width: 720px;
      }

      #catalogRows td:nth-child(3) {
        min-width: 220px;
        white-space: normal;
      }

      #catalogRows td:nth-child(2),
      #catalogRows td:nth-child(4) {
        max-width: 180px;
      }

      .access-editor-grid {
        display: grid;
        gap: 1rem;
        grid-template-columns: minmax(220px, 280px) 1fr;
      }

      .permission-grid {
        display: grid;
        gap: .65rem;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }

      .permission-check {
        border: 1px solid #dde2ee;
        border-radius: 12px;
        padding: .75rem;
      }

      .permission-check small {
        color: #7b8590;
        display: block;
      }

      .cleanup-layout {
        display: grid;
        gap: 1rem;
        grid-template-columns: minmax(280px, 1fr) minmax(280px, 420px);
      }

      .cleanup-panel,
      .cleanup-summary {
        border: 1px solid rgba(13, 110, 253, .12);
        border-radius: 18px;
        background: rgba(255, 255, 255, .82);
        padding: 1rem;
      }

      .cleanup-ranges,
      .cleanup-options {
        display: grid;
        gap: .65rem;
      }

      .cleanup-ranges {
        grid-template-columns: repeat(auto-fit, minmax(140px, max-content));
      }

      .cleanup-option {
        align-items: flex-start;
        border: 1px solid #dde2ee;
        border-radius: 14px;
        cursor: pointer;
        display: flex;
        gap: .75rem;
        padding: .85rem;
        transition: border-color .2s ease, box-shadow .2s ease;
      }

      .cleanup-option:hover {
        border-color: rgba(13, 110, 253, .45);
        box-shadow: 0 10px 24px rgba(13, 110, 253, .08);
      }

      .cleanup-option small {
        color: #7b8590;
        display: block;
        margin-top: .15rem;
      }

      .cleanup-preview-empty {
        border: 1px dashed #b6c7d8;
        border-radius: 14px;
        color: #6c757d;
        padding: 1rem;
        text-align: center;
      }

      .cleanup-preview-item {
        border: 1px solid #e5eaf3;
        border-radius: 14px;
        padding: .8rem;
      }

      .cleanup-preview-item + .cleanup-preview-item {
        margin-top: .65rem;
      }

      .settings-tabs .tab-content {
        padding: 1rem 0 0;
        min-height: 0 !important;
      }

      .settings-tabs .tab-pane {
        min-height: 0 !important;
      }

      .settings-tabs .tab-content > .tab-pane:not(.active),
      .settings-tabs .tab-content > .tab-pane.fade:not(.show) {
        display: none !important;
      }

      .settings-tabs .tab-content > .tab-pane.active.show {
        display: block !important;
        opacity: 1 !important;
      }

      .settings-tabs .tab-pane > :last-child {
        margin-bottom: 0 !important;
      }

      .settings-actions {
        margin-top: 1rem;
      }

      @media (min-width: 1200px) {
        .page-wrapper.pinned:not(.sidebar-hovered) .sidebar-wrapper .brand-container {
          justify-content: center !important;
        }

        .page-wrapper.pinned:not(.sidebar-hovered) .sidebar-wrapper .brand-container .app-brand {
          justify-content: center;
          margin-left: 0 !important;
          min-width: 74px;
          width: 74px;
        }

        .page-wrapper.pinned:not(.sidebar-hovered) .sidebar-wrapper .brand-container .app-brand a {
          align-items: center;
          display: flex;
          justify-content: center;
          width: 74px;
        }

        .page-wrapper.pinned:not(.sidebar-hovered) .sidebar-wrapper .brand-container .app-brand .logo {
          max-height: 48px;
          max-width: 48px;
        }

        .page-wrapper.pinned:not(.sidebar-hovered) .sidebar-wrapper .brand-container .pin-sidebar {
          display: none;
        }
      }

      @media (max-width: 991.98px) {
        .catalog-grid,
        .cleanup-layout {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 767.98px) {
        .app-header {
          align-items: center !important;
          gap: .75rem;
          min-height: auto;
          padding: .8rem 1rem;
        }

        .brand-container-sm {
          flex: 1 1 auto;
          justify-content: space-between;
          min-width: 0;
        }

        .brand-container-sm .app-brand .logo {
          height: 54px;
          max-width: 64px;
          object-fit: contain;
        }

        .brand-container-sm .toggle-sidebar {
          align-items: center;
          background: rgba(255, 255, 255, .88);
          border: 0;
          border-radius: 8px;
          color: var(--bs-primary);
          display: inline-flex;
          flex: 0 0 44px;
          height: 44px;
          justify-content: center;
          margin-left: auto;
          width: 44px;
        }

        .header-actions {
          flex: 0 0 auto;
          margin-left: 0 !important;
        }

        .header-actions > .dropdown.ms-3 {
          margin-left: .25rem !important;
        }

        .app-hero-header {
          align-items: flex-start !important;
          min-height: auto;
          padding: .85rem 1rem;
        }

        .app-body {
          padding: 1rem;
        }

        .custom-tabs-container {
          border-radius: 12px;
          overflow: hidden;
        }

        .settings-tabs .nav-tabs {
          background: #fff;
          display: flex;
          flex-wrap: nowrap;
          gap: .5rem;
          overflow-x: auto;
          padding: .75rem;
          scrollbar-width: thin;
          white-space: nowrap;
        }

        .settings-tabs .nav-tabs .nav-item {
          flex: 0 0 auto;
        }

        .settings-tabs .nav-tabs .nav-link {
          align-items: center;
          border: 1px solid #dde2ee;
          border-radius: 999px;
          display: inline-flex;
          gap: .4rem;
          min-height: 42px;
          padding: .55rem .85rem;
        }

        .settings-tabs .nav-tabs .nav-link.active {
          background: #f4f1ff;
          border-color: var(--bs-primary);
          color: var(--bs-primary);
        }

        .settings-tabs .tab-content {
          padding: 1rem .75rem .75rem;
        }

        .settings-card-soft,
        .cleanup-panel,
        .cleanup-summary {
          border-radius: 12px;
          padding: 1rem !important;
        }

        .catalog-list {
          display: flex;
          gap: .5rem;
          max-height: none;
          overflow-x: auto;
          padding-bottom: .25rem;
        }

        .catalog-list .list-group-item {
          flex: 0 0 auto;
          margin-bottom: 0;
          min-width: 160px;
        }

        .access-editor-grid,
        .permission-grid {
          grid-template-columns: 1fr;
        }

        .cleanup-ranges {
          grid-template-columns: 1fr;
        }

        .table-outer {
          overflow-x: auto;
        }
      }
    </style>

