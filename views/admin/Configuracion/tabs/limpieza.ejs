<div class="settings-card-soft p-4 mb-4">
  <div class="d-flex align-items-start justify-content-between flex-wrap gap-3 mb-3">
    <div>
      <span class="settings-kicker">Mantenimiento</span>
      <h5 class="mb-1">Limpieza del sistema</h5>
      <p class="text-muted mb-0">Selecciona las áreas a limpiar. Primero calcula una vista previa y luego confirma la eliminación.</p>
    </div>
    <button type="button" class="btn btn-outline-primary" id="cleanupPreview">
      <i class="ri-search-eye-line"></i> Calcular limpieza
    </button>
  </div>

  <div class="settings-status alert" id="cleanupStatus"></div>

  <div class="cleanup-layout">
    <section class="cleanup-panel">
      <div class="mb-4">
        <span class="settings-kicker">Antigüedad mínima</span>
        <div class="cleanup-ranges mt-2" id="cleanupRanges">
          <button type="button" class="btn btn-sm btn-primary" data-cleanup-range="all">Desde siempre</button>
          <button type="button" class="btn btn-sm btn-outline-primary" data-cleanup-range="older_24h">Más de 24 horas</button>
          <button type="button" class="btn btn-sm btn-outline-primary" data-cleanup-range="older_7d">Más de 7 días</button>
          <button type="button" class="btn btn-sm btn-outline-primary" data-cleanup-range="older_30d">Más de 30 días</button>
        </div>
      </div>

      <div>
        <span class="settings-kicker">Áreas disponibles</span>
        <div class="cleanup-options mt-2">
          <label class="cleanup-option">
            <input class="form-check-input" type="checkbox" value="portfolioInactiveImages" checked>
            <span>
              <strong>Imágenes inactivas del portafolio</strong>
              <small>Registros desactivados y archivos locales relacionados.</small>
            </span>
          </label>

          <label class="cleanup-option">
            <input class="form-check-input" type="checkbox" value="portfolioOrphanFiles" checked>
            <span>
              <strong>Archivos huérfanos del portafolio</strong>
              <small>Fotos subidas que ya no están conectadas con la base de datos.</small>
            </span>
          </label>

          <label class="cleanup-option">
            <input class="form-check-input" type="checkbox" value="authorizationRequestsProcessed">
            <span>
              <strong>Solicitudes de permisos procesadas</strong>
              <small>Solicitudes aprobadas o rechazadas que ya no necesitas consultar.</small>
            </span>
          </label>

          <label class="cleanup-option">
            <input class="form-check-input" type="checkbox" value="registrationRequestsProcessed">
            <span>
              <strong>Solicitudes de registro procesadas</strong>
              <small>Solicitudes de acceso ya aprobadas o rechazadas.</small>
            </span>
          </label>

          <label class="cleanup-option">
            <input class="form-check-input" type="checkbox" value="sessionsExpired">
            <span>
              <strong>Sesiones vencidas</strong>
              <small>Sesiones expiradas guardadas en MySQL cuando el store persistente esté activo.</small>
            </span>
          </label>
        </div>
      </div>
    </section>

    <aside class="cleanup-summary">
      <span class="settings-kicker">Vista previa</span>
      <h5 class="mb-1">Elementos encontrados</h5>
      <p class="text-muted mb-3">Nada se elimina hasta que confirmes la limpieza.</p>
      <div id="cleanupPreviewResults" class="cleanup-preview-empty">
        Selecciona las áreas y calcula la limpieza para ver el resumen.
      </div>
      <div class="d-flex justify-content-end mt-3">
        <button type="button" class="btn btn-danger" id="cleanupOpenConfirm" disabled>
          <i class="ri-delete-bin-6-line"></i> Ejecutar limpieza
        </button>
      </div>
    </aside>
  </div>
</div>

<div class="modal fade" id="cleanupConfirmModal" tabindex="-1" aria-labelledby="cleanupConfirmModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title" id="cleanupConfirmModalLabel">Confirmar limpieza</h5>
          <small class="text-muted">Esta acción eliminará solo las áreas seleccionadas.</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning mb-3">
          Revisa el resumen antes de continuar. Esta acción no se puede deshacer desde el sistema.
        </div>
        <div id="cleanupConfirmSummary"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" id="cleanupExecute">
          Eliminar seleccionados
        </button>
      </div>
    </div>
  </div>
</div>
