<div class="row justify-content-center">
  <div class="col-xl-5 col-lg-7 col-12">
    <form id="passwordSettingsForm" class="settings-card-soft p-4 mb-4">
      <span class="settings-kicker">Seguridad</span>
      <h5 class="mb-1">Cambiar contraseña</h5>
      <p class="text-muted">Actualiza la contraseña del usuario con sesión iniciada.</p>
      <div class="mb-3">
        <label class="form-label" for="current_password">Contraseña actual</label>
        <input type="password" id="current_password" name="current_password" class="form-control" autocomplete="current-password" required>
      </div>
      <div class="mb-3">
        <label class="form-label" for="new_password">Nueva contraseña</label>
        <input type="password" id="new_password" name="new_password" class="form-control" autocomplete="new-password" minlength="8" required>
        <small class="text-muted">Mínimo 8 caracteres.</small>
      </div>
      <div class="mb-3">
        <label class="form-label" for="confirm_password">Confirmar nueva contraseña</label>
        <input type="password" id="confirm_password" name="confirm_password" class="form-control" autocomplete="new-password" minlength="8" required>
      </div>
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="settings-status alert mb-0" id="passwordSettingsStatus"></div>
        <button type="submit" class="btn btn-primary">
          <i class="ri-lock-password-line"></i> Actualizar contraseña
        </button>
      </div>
    </form>
  </div>
  <div class="col-xl-5 col-lg-7 col-12">
    <form id="sessionSettingsForm" class="settings-card-soft p-4 mb-4">
      <span class="settings-kicker">Sesión</span>
      <h5 class="mb-1">Tiempo de inactividad</h5>
      <p class="text-muted">Define cuántos minutos puede estar inactivo un usuario antes de cerrar la sesión automáticamente.</p>
      <div class="mb-3">
        <label class="form-label" for="session_inactivity_minutes">Minutos de inactividad</label>
        <input type="number" id="session_inactivity_minutes" name="session_inactivity_minutes" class="form-control" min="0" max="1440" step="1" required>
        <small class="text-muted">Usa 0 solo si necesitas desactivar temporalmente el cierre por inactividad.</small>
      </div>
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="settings-status alert mb-0" id="sessionSettingsStatus"></div>
        <button type="submit" class="btn btn-primary">
          <i class="ri-timer-line"></i> Guardar sesión
        </button>
      </div>
    </form>
  </div>
</div>
