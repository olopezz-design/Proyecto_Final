          <!-- App body starts -->
          <div class="app-body">
            <% const actions = typeof portfolioActions !== 'undefined' ? portfolioActions : {}; %>
            <% const canCreatePortfolio = !!actions.canCreate; %>
            <% const canEditPortfolio = !!actions.canEdit; %>
            <% const canDeletePortfolio = !!actions.canDelete; %>

            <div class="portfolio-intro mb-4">
              <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                  <span class="badge bg-primary-subtle text-primary mb-2">Portafolio clínico</span>
                  <h4 class="mb-1">Evidencias por servicio</h4>
                  <p class="text-muted mb-0">
                    Organiza fotos reales del trabajo del Dr. Herbert Castillo por tratamiento o servicio. Cada grupo puede mostrar su propia galería.
                  </p>
                </div>
                <% if (canCreatePortfolio) { %>
                  <button type="button" class="btn btn-primary" id="addPortfolioGroup">
                    <i class="ri-folder-add-line"></i> Nuevo grupo
                  </button>
                <% } %>
              </div>
            </div>

            <div class="alert alert-danger portfolio-status" id="portfolioStatus"></div>

            <% const groups = Array.isArray(portfolioGroups) ? portfolioGroups : []; %>
            <% if (portfolioReady === false) { %>
              <div class="portfolio-empty-state">
                <div class="icon-box lg bg-danger-lighten rounded-5 mb-3">
                  <i class="ri-database-2-line text-danger fs-4"></i>
                </div>
                <h5>La tabla de portafolio aún no está lista</h5>
                <p class="text-muted mb-0">Integra el SQL del portafolio para cargar servicios e imágenes desde la base de datos.</p>
              </div>
            <% } else if (!groups.length) { %>
              <div class="portfolio-empty-state" id="portfolioEmptyState">
                <div class="icon-box lg bg-primary-lighten rounded-5 mb-3">
                  <i class="ri-image-add-line text-primary fs-4"></i>
                </div>
                <h5>Aún no hay servicios para el portafolio</h5>
                <p class="text-muted mb-0"><%= canCreatePortfolio ? 'Crea un grupo desde el botón superior o agrega servicios desde Configuración.' : 'No hay grupos visibles todavía.' %></p>
              </div>
            <% } %>

            <div class="row gx-4 gy-4" id="portfolioGroups">
              <% groups.forEach(function(group) { %>
                <% const images = Array.isArray(group.imagenes) ? group.imagenes : []; %>
                <div class="col-xxl-4 col-lg-6 col-12">
                  <section class="portfolio-service-card" data-service-id="<%= group.id %>">
                    <div class="portfolio-service-header">
                      <div>
                        <span class="badge bg-warning text-dark mb-2">Servicio</span>
                        <h5 class="mb-1" data-service-title><%= group.nombre %></h5>
                        <p class="mb-0" data-service-description><%= group.descripcion || 'Galería de evidencias para este servicio.' %></p>
                        <% if (canEditPortfolio || canDeletePortfolio) { %>
                          <div class="portfolio-service-actions">
                            <% if (canEditPortfolio) { %>
                              <button type="button" class="btn btn-sm btn-outline-light" data-edit-group data-service-id="<%= group.id %>" data-service-name="<%= group.nombre %>" data-service-description="<%= group.descripcion || '' %>">
                                <i class="ri-edit-line"></i> Editar
                              </button>
                            <% } %>
                            <% if (canDeletePortfolio) { %>
                              <button type="button" class="btn btn-sm btn-outline-light" data-delete-group data-service-id="<%= group.id %>" data-service-name="<%= group.nombre %>">
                                <i class="ri-eye-off-line"></i> Ocultar
                              </button>
                            <% } %>
                          </div>
                        <% } %>
                      </div>
                      <span class="portfolio-count" data-photo-count><%= images.length %> <%= images.length === 1 ? 'foto' : 'fotos' %></span>
                    </div>
                    <div class="portfolio-gallery">
                      <div class="baguetteBoxThree gallery row gx-3 gy-3" data-gallery-grid>
                        <% images.forEach(function(image) { %>
                          <div class="col-6 portfolio-photo">
                            <% if (canEditPortfolio) { %>
                              <button type="button" class="portfolio-edit-photo" data-edit-photo="<%= image.id %>" data-service-id="<%= group.id %>" data-title="<%= image.titulo || '' %>" data-description="<%= image.descripcion || '' %>" data-order="<%= image.orden || 0 %>" aria-label="Editar foto">
                                <i class="ri-edit-line"></i>
                              </button>
                            <% } %>
                            <% if (canDeletePortfolio) { %>
                              <button type="button" class="portfolio-delete" data-delete-photo="<%= image.id %>" aria-label="Eliminar foto">
                                <i class="ri-close-line"></i>
                              </button>
                            <% } %>
                            <a href="<%= image.url %>" class="effects">
                              <img src="<%= image.url %>" class="img-fluid" alt="<%= image.titulo || group.nombre %>">
                              <div class="overlay">
                                <span class="expand">+</span>
                              </div>
                            </a>
                            <div class="portfolio-photo-caption">
                              <strong data-photo-title><%= image.titulo || 'Sin título' %></strong>
                              <small class="text-muted d-block" data-photo-description><%= image.descripcion || 'Sin descripción' %></small>
                            </div>
                          </div>
                        <% }); %>
                        <% if (canCreatePortfolio) { %>
                          <div class="col-6">
                            <button type="button" class="portfolio-add-card" data-add-photo data-service-id="<%= group.id %>" data-service-name="<%= group.nombre %>">
                              <span class="expand">+</span>
                              <span class="fw-semibold">Agregar imagen</span>
                              <small class="text-muted">A este servicio</small>
                            </button>
                          </div>
                        <% } %>
                      </div>
                    </div>
                  </section>
                </div>
              <% }); %>
            </div>

            <% if (canCreatePortfolio) { %>
              <div class="modal fade" id="portfolioImageModal" tabindex="-1" aria-labelledby="portfolioImageModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <form class="modal-content" id="portfolioImageForm">
                    <div class="modal-header">
                      <div>
                        <h5 class="modal-title" id="portfolioImageModalLabel">Agregar imagen</h5>
                        <small class="text-muted" id="portfolioImageServiceName"></small>
                      </div>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                      <input type="hidden" id="portfolioServiceId">
                      <div class="mb-3">
                        <label class="form-label" for="portfolioImageFile">Seleccionar imagen</label>
                        <input type="file" class="form-control" id="portfolioImageFile" accept="image/jpeg,image/png,image/webp" required>
                        <small class="text-muted">Formatos permitidos: JPG, PNG o WEBP. Tamaño máximo: 6 MB.</small>
                      </div>
                      <div class="mb-3">
                        <label class="form-label" for="portfolioImageTitle">Título</label>
                        <input type="text" class="form-control" id="portfolioImageTitle" maxlength="150">
                      </div>
                      <div class="mb-0">
                        <label class="form-label" for="portfolioImageDescription">Descripción</label>
                        <textarea class="form-control" id="portfolioImageDescription" rows="3" maxlength="255"></textarea>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                      <button type="submit" class="btn btn-primary">Guardar imagen</button>
                    </div>
                  </form>
                </div>
              </div>
            <% } %>

            <% if (canCreatePortfolio || canEditPortfolio) { %>
              <div class="modal fade" id="portfolioGroupModal" tabindex="-1" aria-labelledby="portfolioGroupModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <form class="modal-content" id="portfolioGroupForm">
                    <div class="modal-header">
                      <div>
                        <h5 class="modal-title" id="portfolioGroupModalLabel">Nuevo grupo</h5>
                        <small class="text-muted">Se guardará como servicio para usarlo en el portafolio.</small>
                      </div>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                      <input type="hidden" id="portfolioGroupId">
                      <div class="mb-3">
                        <label class="form-label" for="portfolioGroupName">Nombre del grupo o servicio</label>
                        <input type="text" class="form-control" id="portfolioGroupName" maxlength="150" required>
                      </div>
                      <div class="mb-0">
                        <label class="form-label" for="portfolioGroupDescription">Descripción breve</label>
                        <textarea class="form-control" id="portfolioGroupDescription" rows="3" maxlength="255"></textarea>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                      <button type="submit" class="btn btn-primary" id="portfolioGroupSubmit">Crear grupo</button>
                    </div>
                  </form>
                </div>
              </div>
            <% } %>

            <% if (canEditPortfolio) { %>
              <div class="modal fade" id="portfolioEditImageModal" tabindex="-1" aria-labelledby="portfolioEditImageModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <form class="modal-content" id="portfolioEditImageForm">
                    <div class="modal-header">
                      <div>
                        <h5 class="modal-title" id="portfolioEditImageModalLabel">Editar imagen</h5>
                        <small class="text-muted">Actualiza cómo se mostrará esta evidencia.</small>
                      </div>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                      <input type="hidden" id="portfolioEditImageId">
                      <div class="mb-3">
                        <label class="form-label" for="portfolioEditImageService">Grupo o servicio</label>
                        <select class="form-select" id="portfolioEditImageService" required>
                          <% groups.forEach(function(group) { %>
                            <option value="<%= group.id %>"><%= group.nombre %></option>
                          <% }); %>
                        </select>
                      </div>
                      <div class="mb-3">
                        <label class="form-label" for="portfolioEditImageTitle">Título</label>
                        <input type="text" class="form-control" id="portfolioEditImageTitle" maxlength="150">
                      </div>
                      <div class="mb-3">
                        <label class="form-label" for="portfolioEditImageDescription">Descripción</label>
                        <textarea class="form-control" id="portfolioEditImageDescription" rows="3" maxlength="255"></textarea>
                      </div>
                      <div class="mb-0">
                        <label class="form-label" for="portfolioEditImageOrder">Orden</label>
                        <input type="number" class="form-control" id="portfolioEditImageOrder" min="0" max="9999" value="0">
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                      <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    </div>
                  </form>
                </div>
              </div>
            <% } %>

            <% if (canDeletePortfolio) { %>
              <div class="modal fade" id="portfolioDeleteGroupModal" tabindex="-1" aria-labelledby="portfolioDeleteGroupModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header">
                      <div>
                        <h5 class="modal-title" id="portfolioDeleteGroupModalLabel">Ocultar grupo</h5>
                        <small class="text-muted" id="portfolioDeleteGroupName"></small>
                      </div>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                      El grupo dejará de mostrarse en el portafolio sin borrar el servicio ni su historial clínico.
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                      <button type="button" class="btn btn-danger" id="confirmDeletePortfolioGroup">Ocultar grupo</button>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>

            <% if (canDeletePortfolio) { %>
              <div class="modal fade" id="portfolioDeleteModal" tabindex="-1" aria-labelledby="portfolioDeleteModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                  <div class="modal-content">
                    <div class="modal-header">
                      <div>
                        <h5 class="modal-title" id="portfolioDeleteModalLabel">Eliminar imagen</h5>
                        <small class="text-muted">La imagen dejará de mostrarse en el portafolio.</small>
                      </div>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                      ¿Deseas eliminar esta imagen del portafolio?
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                      <button type="button" class="btn btn-danger" id="confirmDeletePortfolioImage">Eliminar imagen</button>
                    </div>
                  </div>
                </div>
              </div>
            <% } %>

          </div>
          <!-- App body ends -->

          <!-- App footer starts -->
          <div class="app-footer">
            <span>© C&C Dental Studio 2026</span>
          </div>
          <!-- App footer ends -->

        </div>
        <!-- App container ends -->

      </div>
      <!-- Main container ends -->

    </div>
    <!-- Page wrapper ends -->

    <!-- *************
			************ JavaScript Files *************
		************* -->
    <!-- Required jQuery first, then Bootstrap Bundle JS -->
    <script src="assets/js/jquery.min.js"></script>
    <script src="assets/js/bootstrap.bundle.min.js"></script>
    <script src="assets/js/moment.min.js"></script>

    <!-- *************
			************ Vendor Js Files *************
		************* -->

    <!-- Overlay Scroll JS -->
    <script src="assets/vendor/overlay-scroll/jquery.overlayScrollbars.min.js"></script>
    <script src="assets/vendor/overlay-scroll/custom-scrollbar.js"></script>

    <!-- Date Range JS -->
    <script src="assets/vendor/daterange/daterange.js"></script>
    <script src="assets/vendor/daterange/custom-daterange.js"></script>

    <!-- Gallery JS -->
    <script src="assets/vendor/gallery/baguetteBox.js"></script>
    <script src="assets/vendor/gallery/plugins.js"></script>
    <script src="assets/vendor/gallery/custom-gallery.js"></script>

    <!-- Custom JS files -->
    <script src="assets/js/custom.js"></script>
    <script>
      (() => {
        const portfolioCapabilities = <%- JSON.stringify({
          canCreate: canCreatePortfolio,
          canEdit: canEditPortfolio,
          canDelete: canDeletePortfolio,
        }) %>;
        const portfolioGroups = document.getElementById('portfolioGroups');
        const emptyState = document.getElementById('portfolioEmptyState');
        const status = document.getElementById('portfolioStatus');
        const imageModalElement = document.getElementById('portfolioImageModal');
        const imageModal = imageModalElement ? new bootstrap.Modal(imageModalElement) : null;
        const imageForm = document.getElementById('portfolioImageForm');
        const serviceIdInput = document.getElementById('portfolioServiceId');
        const imageFileInput = document.getElementById('portfolioImageFile');
        const imageTitleInput = document.getElementById('portfolioImageTitle');
        const imageDescriptionInput = document.getElementById('portfolioImageDescription');
        const imageServiceName = document.getElementById('portfolioImageServiceName');
        const groupModalElement = document.getElementById('portfolioGroupModal');
        const groupModal = groupModalElement ? new bootstrap.Modal(groupModalElement) : null;
        const groupForm = document.getElementById('portfolioGroupForm');
        const groupIdInput = document.getElementById('portfolioGroupId');
        const groupNameInput = document.getElementById('portfolioGroupName');
        const groupDescriptionInput = document.getElementById('portfolioGroupDescription');
        const groupModalTitle = document.getElementById('portfolioGroupModalLabel');
        const groupSubmitButton = document.getElementById('portfolioGroupSubmit');
        const editImageModalElement = document.getElementById('portfolioEditImageModal');
        const editImageModal = editImageModalElement ? new bootstrap.Modal(editImageModalElement) : null;
        const editImageForm = document.getElementById('portfolioEditImageForm');
        const editImageIdInput = document.getElementById('portfolioEditImageId');
        const editImageServiceInput = document.getElementById('portfolioEditImageService');
        const editImageTitleInput = document.getElementById('portfolioEditImageTitle');
        const editImageDescriptionInput = document.getElementById('portfolioEditImageDescription');
        const editImageOrderInput = document.getElementById('portfolioEditImageOrder');
        const deleteGroupModalElement = document.getElementById('portfolioDeleteGroupModal');
        const deleteGroupModal = deleteGroupModalElement ? new bootstrap.Modal(deleteGroupModalElement) : null;
        const deleteGroupName = document.getElementById('portfolioDeleteGroupName');
        const confirmDeleteGroupButton = document.getElementById('confirmDeletePortfolioGroup');
        const deleteModalElement = document.getElementById('portfolioDeleteModal');
        const deleteModal = deleteModalElement ? new bootstrap.Modal(deleteModalElement) : null;
        const confirmDeleteButton = document.getElementById('confirmDeletePortfolioImage');
        let activeCard = null;
        let activeGrid = null;
        let pendingDelete = null;
        let pendingGroupDelete = null;
        let pendingEditPhoto = null;

        function escapeHtml(value) {
          return String(value ?? '').replace(/[&<>"']/g, char => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;',
          }[char]));
        }

        function showStatus(message, type = 'danger') {
          if (!status) return;
          status.className = `alert alert-${type} portfolio-status`;
          status.textContent = message || '';
          status.style.display = message ? 'block' : 'none';
        }

        async function requestJson(url, options = {}) {
          const isFormData = options.body instanceof FormData;
          const response = await fetch(url, {
            headers: isFormData ? { ...(options.headers || {}) } : { 'Content-Type': 'application/json', ...(options.headers || {}) },
            ...options,
          });
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.error || 'No se pudo completar la operación');
          return data;
        }

        function updateCount(card) {
          const count = card.querySelectorAll('.portfolio-photo').length;
          const label = card.querySelector('[data-photo-count]');
          if (label) label.textContent = `${count} ${count === 1 ? 'foto' : 'fotos'}`;
        }

        function upsertImageServiceOption(group) {
          if (!editImageServiceInput) return;
          let option = Array.from(editImageServiceInput.options).find(item => String(item.value) === String(group.id));
          if (!option) {
            option = document.createElement('option');
            option.value = group.id;
            editImageServiceInput.appendChild(option);
          }
          option.textContent = group.nombre;
        }

        function findServiceCard(serviceId) {
          return Array.from(portfolioGroups?.querySelectorAll('.portfolio-service-card') || [])
            .find(card => String(card.dataset.serviceId) === String(serviceId));
        }

        function refreshLightbox() {
          if (window.baguetteBox) {
            baguetteBox.run('.baguetteBoxThree', { animation: 'fadeIn' });
          }
        }

        function createPhotoElement(image) {
          const photo = document.createElement('div');
          photo.className = 'col-6 portfolio-photo';
          photo.innerHTML = `
            ${portfolioCapabilities.canEdit ? `
              <button type="button" class="portfolio-edit-photo" data-edit-photo="${escapeHtml(image.id)}" data-service-id="${escapeHtml(image.serviceId)}" data-title="${escapeHtml(image.titulo || '')}" data-description="${escapeHtml(image.descripcion || '')}" data-order="${escapeHtml(image.orden || 0)}" aria-label="Editar foto">
                <i class="ri-edit-line"></i>
              </button>
            ` : ''}
            ${portfolioCapabilities.canDelete ? `
              <button type="button" class="portfolio-delete" data-delete-photo="${escapeHtml(image.id)}" aria-label="Eliminar foto">
                <i class="ri-close-line"></i>
              </button>
            ` : ''}
            <a href="${escapeHtml(image.url)}" class="effects">
              <img src="${escapeHtml(image.url)}" class="img-fluid" alt="${escapeHtml(image.titulo || 'Evidencia del portafolio')}">
              <div class="overlay">
                <span class="expand">+</span>
              </div>
            </a>
            <div class="portfolio-photo-caption">
              <strong data-photo-title>${escapeHtml(image.titulo || 'Sin título')}</strong>
              <small class="text-muted d-block" data-photo-description>${escapeHtml(image.descripcion || 'Sin descripción')}</small>
            </div>`;
          return photo;
        }

        function createGroupElement(group) {
          const wrapper = document.createElement('div');
          wrapper.className = 'col-xxl-4 col-lg-6 col-12';
          wrapper.innerHTML = `
            <section class="portfolio-service-card" data-service-id="${escapeHtml(group.id)}">
              <div class="portfolio-service-header">
                <div>
                  <span class="badge bg-warning text-dark mb-2">Servicio</span>
                  <h5 class="mb-1" data-service-title>${escapeHtml(group.nombre)}</h5>
                  <p class="mb-0" data-service-description>${escapeHtml(group.descripcion || 'Galería de evidencias para este servicio.')}</p>
                  ${(portfolioCapabilities.canEdit || portfolioCapabilities.canDelete) ? `
                    <div class="portfolio-service-actions">
                      ${portfolioCapabilities.canEdit ? `
                        <button type="button" class="btn btn-sm btn-outline-light" data-edit-group data-service-id="${escapeHtml(group.id)}" data-service-name="${escapeHtml(group.nombre)}" data-service-description="${escapeHtml(group.descripcion || '')}">
                          <i class="ri-edit-line"></i> Editar
                        </button>
                      ` : ''}
                      ${portfolioCapabilities.canDelete ? `
                        <button type="button" class="btn btn-sm btn-outline-light" data-delete-group data-service-id="${escapeHtml(group.id)}" data-service-name="${escapeHtml(group.nombre)}">
                          <i class="ri-eye-off-line"></i> Ocultar
                        </button>
                      ` : ''}
                    </div>
                  ` : ''}
                </div>
                <span class="portfolio-count" data-photo-count>0 fotos</span>
              </div>
              <div class="portfolio-gallery">
                <div class="baguetteBoxThree gallery row gx-3 gy-3" data-gallery-grid>
                  ${portfolioCapabilities.canCreate ? `
                    <div class="col-6">
                      <button type="button" class="portfolio-add-card" data-add-photo data-service-id="${escapeHtml(group.id)}" data-service-name="${escapeHtml(group.nombre)}">
                        <span class="expand">+</span>
                        <span class="fw-semibold">Agregar imagen</span>
                        <small class="text-muted">A este servicio</small>
                      </button>
                    </div>
                  ` : ''}
                </div>
              </div>
            </section>`;
          return wrapper;
        }

        function bindAddPhoto(button) {
          button.addEventListener('click', () => {
            activeCard = button.closest('.portfolio-service-card');
            activeGrid = button.closest('[data-gallery-grid]');
            imageForm?.reset();
            serviceIdInput.value = button.dataset.serviceId || '';
            imageServiceName.textContent = button.dataset.serviceName || '';
            imageModal?.show();
          });
        }

        document.querySelectorAll('[data-add-photo]').forEach(bindAddPhoto);

        imageForm?.addEventListener('submit', async event => {
          event.preventDefault();
          if (!activeGrid || !activeCard) return;

          try {
            if (!imageFileInput.files?.[0]) {
              showStatus('Selecciona una imagen para subir.', 'warning');
              return;
            }

            const formData = new FormData();
            formData.append('servicio_idservicio', serviceIdInput.value);
            formData.append('titulo', imageTitleInput.value);
            formData.append('descripcion', imageDescriptionInput.value);
            formData.append('imagen', imageFileInput.files[0]);

            const data = await requestJson('/admin/portafolio/imagenes', {
              method: 'POST',
              body: formData,
            });

            const addCard = activeGrid.querySelector('[data-add-photo]')?.closest('.col-6');
            activeGrid.insertBefore(createPhotoElement(data.imagen), addCard);
            updateCount(activeCard);
            refreshLightbox();
            imageModal?.hide();
            showStatus('', 'success');
          } catch (error) {
            showStatus(error.message, 'danger');
          }
        });

        editImageForm?.addEventListener('submit', async event => {
          event.preventDefault();
          const id = editImageIdInput.value;
          if (!id || !pendingEditPhoto?.photo) return;

          try {
            const payload = {
              servicio_idservicio: editImageServiceInput.value,
              titulo: editImageTitleInput.value.trim(),
              descripcion: editImageDescriptionInput.value.trim(),
              orden: Number(editImageOrderInput.value || 0),
            };
            const data = await requestJson(`/admin/portafolio/imagenes/${encodeURIComponent(id)}`, {
              method: 'PUT',
              body: JSON.stringify(payload),
            });

            pendingEditPhoto.button.dataset.serviceId = data.imagen.servicioId;
            pendingEditPhoto.button.dataset.title = data.imagen.titulo;
            pendingEditPhoto.button.dataset.description = data.imagen.descripcion;
            pendingEditPhoto.button.dataset.order = data.imagen.orden;
            pendingEditPhoto.photo.querySelector('[data-photo-title]').textContent = data.imagen.titulo || 'Sin título';
            pendingEditPhoto.photo.querySelector('[data-photo-description]').textContent = data.imagen.descripcion || 'Sin descripción';

            const targetGrid = findServiceCard(data.imagen.servicioId)?.querySelector('[data-gallery-grid]');
            if (targetGrid && targetGrid !== pendingEditPhoto.photo.parentElement) {
              const oldCard = pendingEditPhoto.card;
              const newCard = targetGrid.closest('.portfolio-service-card');
              const addCard = targetGrid.querySelector('[data-add-photo]')?.closest('.col-6');
              targetGrid.insertBefore(pendingEditPhoto.photo, addCard);
              if (oldCard) updateCount(oldCard);
              if (newCard) updateCount(newCard);
            }

            refreshLightbox();
            editImageModal?.hide();
            pendingEditPhoto = null;
            showStatus('', 'success');
          } catch (error) {
            showStatus(error.message, 'danger');
          }
        });

        document.addEventListener('click', event => {
          const editPhotoButton = event.target.closest('[data-edit-photo]');
          if (editPhotoButton) {
            pendingEditPhoto = {
              button: editPhotoButton,
              photo: editPhotoButton.closest('.portfolio-photo'),
              card: editPhotoButton.closest('.portfolio-service-card'),
            };
            editImageForm?.reset();
            editImageIdInput.value = editPhotoButton.dataset.editPhoto || '';
            editImageServiceInput.value = editPhotoButton.dataset.serviceId || '';
            editImageTitleInput.value = editPhotoButton.dataset.title || '';
            editImageDescriptionInput.value = editPhotoButton.dataset.description || '';
            editImageOrderInput.value = editPhotoButton.dataset.order || '0';
            editImageModal?.show();
            return;
          }

          const editGroupButton = event.target.closest('[data-edit-group]');
          if (editGroupButton) {
            groupForm?.reset();
            groupIdInput.value = editGroupButton.dataset.serviceId || '';
            groupNameInput.value = editGroupButton.dataset.serviceName || '';
            groupDescriptionInput.value = editGroupButton.dataset.serviceDescription || '';
            groupModalTitle.textContent = 'Editar grupo';
            groupSubmitButton.textContent = 'Guardar cambios';
            groupModal?.show();
            setTimeout(() => groupNameInput?.focus(), 150);
            return;
          }

          const deleteGroupButton = event.target.closest('[data-delete-group]');
          if (deleteGroupButton) {
            pendingGroupDelete = {
              id: deleteGroupButton.dataset.serviceId,
              wrapper: deleteGroupButton.closest('.col-xxl-4, .col-lg-6, .col-12'),
              name: deleteGroupButton.dataset.serviceName || '',
            };
            if (deleteGroupName) deleteGroupName.textContent = pendingGroupDelete.name;
            deleteGroupModal?.show();
            return;
          }

          const deleteButton = event.target.closest('[data-delete-photo]');
          if (!deleteButton) return;

          pendingDelete = {
            id: deleteButton.dataset.deletePhoto,
            photo: deleteButton.closest('.portfolio-photo'),
            card: deleteButton.closest('.portfolio-service-card'),
          };
          deleteModal?.show();
        });

        confirmDeleteButton?.addEventListener('click', async () => {
          if (!pendingDelete?.id) return;

          try {
            await requestJson(`/admin/portafolio/imagenes/${encodeURIComponent(pendingDelete.id)}`, {
              method: 'DELETE',
            });
            pendingDelete.photo?.remove();
            if (pendingDelete.card) updateCount(pendingDelete.card);
            refreshLightbox();
            showStatus('', 'success');
            deleteModal?.hide();
            pendingDelete = null;
          } catch (error) {
            showStatus(error.message, 'danger');
          }
        });

        document.getElementById('addPortfolioGroup')?.addEventListener('click', () => {
          groupForm?.reset();
          groupIdInput.value = '';
          groupModalTitle.textContent = 'Nuevo grupo';
          groupSubmitButton.textContent = 'Crear grupo';
          groupModal?.show();
          setTimeout(() => groupNameInput?.focus(), 150);
        });

        groupForm?.addEventListener('submit', async event => {
          event.preventDefault();
          const groupId = groupIdInput?.value;
          const groupName = groupNameInput?.value?.trim();
          const groupDescription = groupDescriptionInput?.value?.trim();
          if (!groupName) return;

          try {
            const data = await requestJson(groupId ? `/admin/portafolio/grupos/${encodeURIComponent(groupId)}` : '/admin/portafolio/grupos', {
              method: groupId ? 'PUT' : 'POST',
              body: JSON.stringify({ nombre: groupName, descripcion: groupDescription }),
            });

            if (groupId) {
              const card = findServiceCard(groupId);
              if (card) {
                const title = card.querySelector('[data-service-title]');
                const description = card.querySelector('[data-service-description]');
                const addButton = card.querySelector('[data-add-photo]');
                const editButton = card.querySelector('[data-edit-group]');
                const deleteButton = card.querySelector('[data-delete-group]');
                if (title) title.textContent = data.nombre;
                if (description) description.textContent = data.descripcion || 'Galería de evidencias para este servicio.';
                if (addButton) addButton.dataset.serviceName = data.nombre;
                if (editButton) {
                  editButton.dataset.serviceName = data.nombre;
                  editButton.dataset.serviceDescription = data.descripcion || '';
                }
                if (deleteButton) deleteButton.dataset.serviceName = data.nombre;
              }
              upsertImageServiceOption(data);
            } else {
              const group = createGroupElement(data);
              bindAddPhoto(group.querySelector('[data-add-photo]'));
              emptyState?.remove();
              portfolioGroups?.appendChild(group);
              upsertImageServiceOption(data);
            }

            groupModal?.hide();
            showStatus('', 'success');
          } catch (error) {
            showStatus(error.message, 'danger');
          }
        });

        confirmDeleteGroupButton?.addEventListener('click', async () => {
          if (!pendingGroupDelete?.id) return;

          try {
            await requestJson(`/admin/portafolio/grupos/${encodeURIComponent(pendingGroupDelete.id)}`, {
              method: 'DELETE',
            });
            pendingGroupDelete.wrapper?.remove();
            Array.from(editImageServiceInput?.options || []).forEach(option => {
              if (String(option.value) === String(pendingGroupDelete.id)) option.remove();
            });
            deleteGroupModal?.hide();
            pendingGroupDelete = null;
            showStatus('', 'success');
          } catch (error) {
            showStatus(error.message, 'danger');
          }
        });
      })();
    </script>
  </body>

</html>
