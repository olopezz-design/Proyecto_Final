    <style>
      .header-actions > .d-lg-flex.d-none.gap-2 {
        display: none !important;
      }

      .profile-initials-badge {
        align-items: center;
        background: #f4f1ff;
        color: #705df3;
        display: inline-flex;
        font-weight: 800;
        justify-content: center;
      }

      @media (min-width: 1200px) {
        .page-wrapper.pinned:not(.sidebar-hovered) .sidebar-wrapper .brand-container {
          justify-content: center !important;
        }

        .page-wrapper.pinned:not(.sidebar-hovered) .sidebar-wrapper .brand-container .app-brand {
          justify-content: center;
          margin-left: 0 !important;
          min-width: 74px;
          width: 74px;
        }

        .page-wrapper.pinned:not(.sidebar-hovered) .sidebar-wrapper .brand-container .app-brand a {
          align-items: center;
          display: flex;
          justify-content: center;
          width: 74px;
        }

        .page-wrapper.pinned:not(.sidebar-hovered) .sidebar-wrapper .brand-container .app-brand .logo {
          max-height: 48px;
          max-width: 48px;
        }

        .page-wrapper.pinned:not(.sidebar-hovered) .sidebar-wrapper .brand-container .pin-sidebar {
          display: none;
        }
      }

      .portfolio-intro {
        background: linear-gradient(135deg, #f7fbff 0%, #f1effe 100%);
        border: 1px solid #dde2ee;
        border-radius: 18px;
        padding: 1.25rem;
      }

      .portfolio-service-card {
        border: 1px solid #dde2ee;
        border-radius: 18px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 14px 30px rgba(40, 90, 185, .08);
      }

      .portfolio-service-header {
        align-items: center;
        background:
          radial-gradient(circle at top right, rgba(115, 103, 240, .18), transparent 32%),
          linear-gradient(135deg, #132238, #1b4d64);
        color: #ffffff;
        display: flex;
        justify-content: space-between;
        min-height: 150px;
        padding: 1.25rem;
      }

      .portfolio-service-actions {
        display: flex;
        gap: .4rem;
        justify-content: flex-end;
        margin-top: .8rem;
      }

      .portfolio-service-actions .btn {
        border-color: rgba(255, 255, 255, .3);
        color: #ffffff;
      }

      .portfolio-service-actions .btn:hover {
        background: rgba(255, 255, 255, .14);
        color: #ffffff;
      }

      .portfolio-service-header h5 {
        color: #ffffff;
        font-weight: 700;
      }

      .portfolio-service-header p {
        color: rgba(255, 255, 255, .78);
      }

      .portfolio-count {
        background: rgba(255, 255, 255, .12);
        border: 1px solid rgba(255, 255, 255, .22);
        border-radius: 999px;
        color: #ffffff;
        padding: .35rem .75rem;
      }

      .portfolio-gallery {
        padding: 1rem;
      }

      .portfolio-gallery .effects {
        margin-bottom: 0;
      }

      .portfolio-photo {
        position: relative;
      }

      .portfolio-photo img {
        aspect-ratio: 4 / 3;
        object-fit: cover;
        width: 100%;
      }

      .portfolio-delete {
        align-items: center;
        background: rgba(255, 59, 65, .92);
        border: 0;
        border-radius: 999px;
        color: #ffffff;
        display: flex;
        height: 30px;
        justify-content: center;
        position: absolute;
        right: 10px;
        top: 10px;
        width: 30px;
        z-index: 30;
      }

      .portfolio-edit-photo {
        align-items: center;
        background: rgba(13, 110, 253, .92);
        border: 0;
        border-radius: 999px;
        color: #ffffff;
        display: flex;
        height: 30px;
        justify-content: center;
        position: absolute;
        right: 48px;
        top: 10px;
        width: 30px;
        z-index: 30;
      }

      .portfolio-photo-caption {
        background: #ffffff;
        border: 1px solid #edf1f5;
        border-top: 0;
        border-radius: 0 0 8px 8px;
        font-size: .82rem;
        padding: .55rem .65rem;
      }

      .portfolio-add-card {
        align-items: center;
        aspect-ratio: 4 / 3;
        background: #f8fbff;
        border: 1px dashed #7367f0;
        border-radius: 8px;
        color: #7367f0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 140px;
        text-align: center;
        width: 100%;
      }

      .portfolio-add-card:hover {
        background: #f1f0ff;
      }

      .portfolio-add-card .expand {
        align-items: center;
        border: 2px solid #ffb037;
        border-radius: 8px;
        color: #ffb037;
        display: flex;
        font-size: 1.5rem;
        height: 38px;
        justify-content: center;
        line-height: 1;
        margin-bottom: .5rem;
        width: 38px;
      }

      .portfolio-empty-state {
        align-items: center;
        background: linear-gradient(135deg, #ffffff, #f8fbff);
        border: 1px dashed #b9c3ca;
        border-radius: 18px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 260px;
        padding: 2rem;
        text-align: center;
      }

      .portfolio-status {
        display: none;
      }
    </style>

