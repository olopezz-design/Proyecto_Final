    <link rel="shortcut icon" type="image/svg+xml" href="/images/cnc-favicon.svg">
    <link rel="stylesheet" href="/css/dashboard.css">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.21/css/jquery.dataTables.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
    <style>

         /* Sidebar */
         #sidebar-wrapper {
            width: 250px;
            background-color: #2c3e50;
            color: #ecf0f1;
            height: 100vh;
        }
        .list-group-item {
            font-size: 1.1rem;
            transition: background 0.3s;
        }
        .list-group-item:hover {
            background-color: #34495e;
        }

        /* Submenu indent and icon styling */
        .list-group-item-action .pl-5 {
            padding-left: 2.5rem;
        }

        /* Submenu style */
        .list-group-item-action.collapse.show .list-group-item {
            background: #2c3e50;
        }




        /* Estilo para los botones de paginación */
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            color: #007bff;
            background-color: transparent;
            border: none;
            padding: 0;
            margin: 0 5px;
            font-size: 14px;
            cursor: pointer;
        }

        /* Estilo para el botón de la página actual */
        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            font-weight: bold;
            color: white;
            background-color: #007bff;
            border: none;
            border-radius: 4px;
        }

        /* Ocultar el cuadro de búsqueda predeterminado de DataTables */
        .dataTables_filter { display: none; }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
        }

        #page-content-wrapper { flex: 1; }

        footer {
            background-color: #343a40;
            color: white;
            text-align: center;
            padding: 10px 0;
        }

        .modal-body {
            max-height: 400px;
            overflow-y: auto;
        }

        .separar-pdf { margin-top: 20px; }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <div class="d-flex flex-grow-1" id="wrapper">
        <!-- Sidebar -->
        <div class="bg-dark border-right" id="sidebar-wrapper">
            <div class="sidebar-heading text-center py-4">
                <img src="/images/cnc-logo-alt.svg" alt="Logo" class="img-fluid mb-2" style="max-width: 50px;">
                <h4 class="text-white font-weight-bold">C&C Dental Studio</h4>
            </div>
            <div class="list-group list-group-flush">
                
                <!-- Pacientes -->
                <a href="#clientes-pacientes-submenu" class="list-group-item list-group-item-action bg-dark text-white d-flex justify-content-between align-items-center" data-toggle="collapse">
                    <i class="fas fa-user mr-2"></i> Pacientes
                    <i class="fas fa-chevron-down"></i>
                </a>
                <div id="clientes-pacientes-submenu" class="collapse">
                    <a href="/admin/pacientes" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-user-friends"></i> Lista de Pacientes
                    </a>
                    <a href="/admin/citas" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-calendar-alt"></i> Citas
                    </a>
                    <a href="/admin/historial" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-file-medical-alt"></i> Historial Tratamiento
                    </a>
                    <a href="/admin/pago" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-wallet"></i> Control de Pago
                    </a>
                    <a href="/admin/archivados" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-archive"></i> Pacientes Archivados
                    </a>
                </div>

                <!-- Doctores -->
                <a href="#doctores-submenu" class="list-group-item list-group-item-action bg-dark text-white d-flex justify-content-between align-items-center" data-toggle="collapse">
                    <i class="fas fa-user-md mr-2"></i> Doctores
                    <i class="fas fa-chevron-down"></i>
                </a>
                <div id="doctores-submenu" class="collapse">
                    <a href="/admin/doctores" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-user-check"></i> Doctores Activos
                    </a>
                    <a href="/admin/doctores/inactivos" class="list-group-item list-group-item-action bg-dark text-white pl-5 active">
                        <i class="fas fa-user-slash"></i> Doctores Inactivos
                    </a>
                </div>

                <!-- Inventario -->
                <a href="#inventario-submenu" class="list-group-item list-group-item-action bg-dark text-white d-flex justify-content-between align-items-center" data-toggle="collapse">
                    <i class="fas fa-box mr-2"></i> Inventario
                    <i class="fas fa-chevron-down"></i>
                </a>
                <div id="inventario-submenu" class="collapse">
                    <a href="/admin/marcas" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-tags"></i> Marcas
                    </a>
                    <a href="/admin/categorias" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-th-large"></i> Categorías
                    </a>
                    <a href="/admin/proveedores" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-truck"></i> Proveedores
                    </a>
                    <a href="/admin/productos" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-boxes"></i> Productos
                    </a>
                    <a href="/admin/comprasProductos" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-shopping-cart"></i> Compras
                    </a>
                    <a href="/admin/salidasProductos" class="list-group-item list-group-item-action bg-dark text-white pl-5">
                        <i class="fas fa-dolly"></i> Salidas
                    </a>
                </div>

                <a href="/admin/cotizaciones" class="list-group-item list-group-item-action bg-dark text-white">
                    <i class="fas fa-arrow-circle-left"></i> Generar Cotización
                </a>
                <a href="/admin/dashboard" class="list-group-item list-group-item-action bg-dark text-white">
                    <i class="fas fa-arrow-circle-left"></i> Regresar al Panel
                </a>
                <a href="/logout" class="list-group-item list-group-item-action bg-danger text-white">
                    <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                </a>
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper">
            <div class="container-fluid">
                <h1 class="mt-4">Doctores Inactivos</h1>
                <div class="text-left mb-3">
                    <a href="/admin/dashboard" class="btn btn-secondary">&larr; Regresar al Panel de Control</a>
                </div>

                <!-- Barra de búsqueda -->
                <div class="input-group mb-3">
                    <input type="text" class="form-control" placeholder="Buscar doctor..." id="searchDoctor">
                </div>

               <!-- Tabla de doctores -->
                <div class="text-right mb-3"></div>
                <table class="table table-bordered" id="doctorTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Usuario</th>
                            <th>Nombre</th>
                            <th>Especialidad</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="doctorList">
                        <% 
                        const especialidades = [
                            "Otro", // índice 0
                            "Dentista General", // índice 1
                            "Ortodoncista", // índice 2
                            "Cirujano Maxilofacial", // índice 3
                            "Endodoncia", // índice 4
                            "Periodoncia", // índice 5
                            "Odontólogo Cosmético", // índice 6
                            "Odontólogo Restaurador", // índice 7
                            "Prótesis Dental" // índice 8
                        ];
                        
                        doctores.forEach(function(doctor) { 
                        %>
                        <tr>
                            <td><%= doctor.iddoctor %></td>
                            <td><%= doctor.usuario_nombre %></td>
                            <td><%= doctor.nombre + " " + doctor.apellido %></td>
                            <td><%= especialidades[doctor.especialidad_idespecialidad] || "Otro" %></td>
                            <td>
                                <div class="d-flex justify-content-around">
                                    <% if (can('doctores:editar')) { %>
                                        <!-- Botón para editar doctor -->
                                        <button class="btn btn-primary btn-sm mx-1" onclick="editarDoctor(
                                            '<%= doctor.iddoctor %>', 
                                            '<%= doctor.nombre %>', 
                                            '<%= doctor.apellido %>', 
                                            '<%= doctor.telefono %>', 
                                            '<%= doctor.email %>', 
                                            '<%= doctor.domicilio %>', 
                                            '<%= doctor.especialidad_idespecialidad %>', 
                                            '<%= doctor.dpi %>', 
                                            '<%= doctor.tipoSangre %>', 
                                            '<%= new Date(doctor.fechaNacimiento).toISOString().split('T')[0] %>', 
                                            '<%= doctor.observacion %>'
                                        )" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    <% } %>
                                
                                    <!-- Botón para ver información del doctor -->
                                    <button class="btn btn-info btn-sm mx-1" onclick="verInformacion(
                                        '<%= doctor.iddoctor %>', 
                                        '<%= doctor.usuario_idusuario %>', 
                                        '<%= doctor.nombre %>', 
                                        '<%= doctor.apellido %>', 
                                        '<%= doctor.telefono %>', 
                                        '<%= doctor.email %>', 
                                        '<%= doctor.observacion %>', 
                                        '<%= doctor.especialidad_idespecialidad %>', 
                                        '<%= doctor.dpi %>', 
                                        '<%= doctor.fechaNacimiento %>', 
                                        '<%= doctor.tipoSangre %>', 
                                        '<%= doctor.genero %>', 
                                        '<%= doctor.domicilio %>'
                                    )" title="Ver Información">
                                        <i class="fas fa-info-circle"></i>
                                    </button>
                                
                                    <% if (can('doctores:inactivar')) { %>
                                        <!-- Botón para reactivar doctor -->
                                        <form onsubmit="event.preventDefault(); reactivarDoctor('<%= doctor.iddoctor %>')" class="d-inline">
                                            <button class="btn btn-success btn-sm mx-1" type="submit" title="Reactivar">
                                                <i class="fas fa-user-check"></i>
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                                
                                
                                
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>                    
                </table>


<% if (can('doctores:editar')) { %>
    <%- include('DoctoresInactivos/modals/editDoctor') %>
<% } %>




<script>
function editarDoctor(id, nombre, apellido, telefono, email, domicilio, especialidad_idespecialidad, dpi, tipoSangre, fechaNacimiento, observacion) {
    document.getElementById('editDoctorId').value = id;
    document.getElementById('editNombre').value = nombre;
    document.getElementById('editApellido').value = apellido;
    document.getElementById('editTelefono').value = telefono;
    document.getElementById('editEmail').value = email;
    document.getElementById('editDomicilio').value = domicilio;
    document.getElementById('editEspecialidad').value = especialidad_idespecialidad;
    document.getElementById('editDPI').value = dpi;

    // Formatear y asignar la fecha de nacimiento (si existe)
    if (fechaNacimiento) {
        const formattedDate = new Date(fechaNacimiento).toISOString().split('T')[0];
       // document.getElementById('editFechaNacimiento').value = formattedDate;
    }

    // Asignar el tipo de sangre
    document.getElementById('editTipoSangre').value = tipoSangre;

    // Asignar la observación
    document.getElementById('editObservacion').value = observacion;

    // Abrir el modal de edición
    $('#editDoctorModal').modal('show');
}


    // Manejo del envío del formulario de edición
    const editDoctorForm = document.getElementById('editDoctorForm');
    if (editDoctorForm) editDoctorForm.addEventListener('submit', function(event) {
        event.preventDefault();

        const data = {
            iddoctor: document.getElementById('editDoctorId').value,
            nombre: document.getElementById('editNombre').value,
            apellido: document.getElementById('editApellido').value,
            telefono: document.getElementById('editTelefono').value,
            email: document.getElementById('editEmail').value,
            domicilio: document.getElementById('editDomicilio').value,
            especialidad_idespecialidad: document.getElementById('editEspecialidad').value,
            tipoSangre: document.getElementById('editTipoSangre').value,
            observacion: document.getElementById('editObservacion').value
        };

        fetch(`/admin/doctores/${data.iddoctor}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(result => {
            if (result.success) {
                showUiMessage('Doctor actualizado correctamente.', 'success');
                $('#editDoctorModal').modal('hide'); // Cerrar el modal
                location.reload(); // Recargar la página para actualizar la tabla
            } else {
                showUiMessage('Error al actualizar el doctor.', 'danger');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showUiMessage('Hubo un problema al actualizar el doctor.', 'danger');
        });
    });
</script>





<%- include('DoctoresInactivos/modals/viewDoctor') %>



<script>
function verInformacion(id, usuarioId, nombre, apellido, telefono, email, observacion, especialidad_idespecialidad, dpi, fechaNacimiento, tipoSangre, domicilio, genero_idGenero) {
    // Formatear fecha de nacimiento
    const formattedFechaNacimiento = fechaNacimiento ? new Date(fechaNacimiento).toLocaleDateString('es-ES', {
        year: 'numeric',
        month: 'long',
        day: 'numeric'
    }) : 'No disponible';

    // Verificar tipo de género y ajustarlo si es necesario
    const generoParsed = typeof genero_idGenero === 'string' ? parseInt(genero_idGenero) : genero_idGenero;

    // Asignar valores a los campos de visualización
    $('#viewNombre').text(nombre || 'No disponible');
    $('#viewApellido').text(apellido || 'No disponible');
    $('#viewTelefono').text(telefono || 'No disponible');
    $('#viewEmail').text(email || 'No disponible');
    $('#viewDomicilio').text(domicilio || 'No disponible');
    $('#viewGenero').text(getGeneroName(generoParsed));
    $('#viewEspecialidad').text(getEspecialidadName(especialidad_idespecialidad));
    $('#viewDPI').text(dpi || 'No disponible');
    $('#viewFechaNacimiento').text(formattedFechaNacimiento);
    $('#viewTipoSangre').text(tipoSangre || 'No disponible');
    $('#viewObservacion').text(observacion || 'No disponible');

    // Mostrar el modal de información
    $('#viewDoctorModal').modal('show');
}

// Función para obtener el nombre del género
function getGeneroName(id) {
    const generos = {
        1: 'Masculino',
        2: 'Femenino',
        3: 'Otro'
    };
    return generos[id] || 'Género Desconocido';
}

// Función para obtener el nombre de la especialidad
function getEspecialidadName(id) {
    const especialidades = {
        1: 'Dentista General',
        2: 'Ortodoncista',
        3: 'Cirujano Maxilofacial',
        4: 'Endodoncia',
        5: 'Periodoncia',
        6: 'Odontólogo Cosmético',
        7: 'Odontólogo Restaurador',
        8: 'Prótesis Dental'
    };
    return especialidades[id] || 'Especialidad Desconocida';
}

</script>





















<!-- Scripts -->
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://cdn.datatables.net/1.10.21/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>


<script>

$(document).ready(function() {
            $('#doctorTable').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                info: true,
                lengthChange: false,
                language: {
                    paginate: { previous: "<", next: ">" },
                    emptyTable: "No hay datos disponibles en la tabla"
                }
            });
        });




       // Función para reactivar un doctor
       function reactivarDoctor(idDoctor) {
            fetch(`/api/admin/doctores/${idDoctor}/reactivar`, {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error('Error al reactivar el doctor');
                }
                return response.json();
            })
            .then(data => {
                showUiMessage(data.message || 'Doctor reactivado correctamente.', 'success');
                location.reload(); // Recargar la página para ver los cambios
            })
            .catch(error => {
                console.error('Error:', error);
                showUiMessage('Hubo un problema al reactivar el doctor.', 'danger');
            });
        }
  

</script>
<%- include('partials/uiFeedback') %>


<%- include('partials/pageLoader') %>
</body>
</html>
