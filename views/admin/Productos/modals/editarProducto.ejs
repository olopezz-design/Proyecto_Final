<!-- Modal de edición de producto -->
<div class="modal fade" id="editarProductoModal" tabindex="-1" aria-labelledby="editarProductoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="editarProductoModalLabel">Editar Producto</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <!-- Formulario de edición del producto -->
          <form id="editarProductoForm" method="POST" action="/admin/editarProducto">
            <input type="hidden" id="productoId" name="productoId">

            <!-- Nombre del producto -->
            <div class="mb-3">
              <label for="editarNombreProducto" class="form-label">Nombre del Producto</label>
              <input type="text" class="form-control" id="editarNombreProducto" name="nombreProducto" required>
            </div>

            <!-- Descripción del producto -->
            <div class="mb-3">
              <label for="editarDescripcionProducto" class="form-label">Descripción</label>
              <textarea class="form-control" id="editarDescripcionProducto" name="descripcionProducto" rows="3"></textarea>
            </div>

            <!-- Precio del producto -->
            <div class="mb-3">
              <label for="editarPrecioProducto" class="form-label">Precio</label>
              <input type="number" class="form-control" id="editarPrecioProducto" name="precioProducto" step="0.01" required>
            </div>

            <!-- Fecha de expiración -->
            <div class="mb-3">
              <label for="editarFechaExpiracionProducto" class="form-label">Fecha de Expiración</label>
              <input type="date" class="form-control" id="editarFechaExpiracionProducto" name="fechaExpiracionProducto">
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="editarStockInicialProducto" class="form-label">Stock actual</label>
                <input type="number" class="form-control" id="editarStockInicialProducto" name="stockInicialProducto" min="0" step="1" value="0" required>
              </div>
              <div class="col-md-6 mb-3">
                <label for="editarStockMinimoProducto" class="form-label">Stock mínimo</label>
                <input type="number" class="form-control" id="editarStockMinimoProducto" name="stockMinimoProducto" min="0" step="1" value="0" required>
              </div>
            </div>

            <!-- Selección de Marca -->
            <div class="mb-3">
              <label for="editarMarcaProducto" class="form-label">Marca</label>
              <select class="form-control" id="editarMarcaProducto" name="marcaProducto" required>
                <!-- Aquí se llenan las marcas dinámicamente -->
                <% marcas.forEach(marca => { %>
                  <option value="<%= marca.id %>"><%= marca.nombre %></option>
                <% }); %>
              </select>
            </div>

            <div class="mb-3">
              <label for="editarMarcasProducto" class="form-label">Marcas adicionales</label>
              <select class="form-control" id="editarMarcasProducto" name="marcasProducto" multiple>
                <% marcas.forEach(marca => { %>
                  <option value="<%= marca.id %>"><%= marca.nombre %></option>
                <% }); %>
              </select>
            </div>

            <!-- Selección de Categoría -->
            <div class="mb-3">
              <label for="editarCategoriaProducto" class="form-label">Categoría</label>
              <select class="form-control" id="editarCategoriaProducto" name="categoriaProducto" required>
                <!-- Aquí se llenan las categorías dinámicamente -->
                <% categorias.forEach(categoria => { %>
                  <option value="<%= categoria.idcategoria %>"><%= categoria.nombre %></option>
                <% }); %>
              </select>
            </div>

            <div class="mb-3">
              <label for="editarProveedoresProducto" class="form-label">Proveedor(es)</label>
              <select class="form-control" id="editarProveedoresProducto" name="proveedoresProducto" multiple>
                <% (typeof proveedores !== 'undefined' ? proveedores : []).forEach(proveedor => { %>
                  <option value="<%= proveedor.id %>"><%= proveedor.nombre %></option>
                <% }); %>
              </select>
            </div>

            <button type="submit" class="btn btn-primary">Guardar Cambios</button>
          </form>
        </div>
      </div>
    </div>
  </div>
