<!-- Modal para agregar producto -->
<div class="modal fade" id="addProductoModal" tabindex="-1" aria-labelledby="addProductoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addProductoModalLabel">Agregar Producto</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <!-- Formulario para agregar producto -->
          <form id="agregarProductoForm" method="POST" action="/admin/agregarProducto">
            <!-- Nombre del producto -->
            <div class="mb-3">
              <label for="nombreProducto" class="form-label">Nombre del Producto</label>
              <input type="text" class="form-control" id="nombreProducto" name="nombreProducto" required>
            </div>

            <!-- Descripción del producto -->
            <div class="mb-3">
              <label for="descripcionProducto" class="form-label">Descripción</label>
              <textarea class="form-control" id="descripcionProducto" name="descripcionProducto" rows="3"></textarea>
            </div>

            <!-- Precio del producto -->
            <div class="mb-3">
              <label for="precioProducto" class="form-label">Precio</label>
              <input type="number" class="form-control" id="precioProducto" name="precioProducto" step="0.01" required>
            </div>

            <!-- Fecha de expiración -->
            <div class="mb-3">
              <label for="fechaExpiracionProducto" class="form-label">Fecha de Expiración</label>
              <input type="date" class="form-control" id="fechaExpiracionProducto" name="fechaExpiracionProducto">
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label for="stockInicialProducto" class="form-label">Stock inicial</label>
                <input type="number" class="form-control" id="stockInicialProducto" name="stockInicialProducto" min="0" step="1" value="0" required>
              </div>
              <div class="col-md-6 mb-3">
                <label for="stockMinimoProducto" class="form-label">Stock mínimo</label>
                <input type="number" class="form-control" id="stockMinimoProducto" name="stockMinimoProducto" min="0" step="1" value="0" required>
              </div>
            </div>

            <!-- Selección de Marca -->
            <div class="mb-3">
              <label for="marcaProducto" class="form-label">Marca</label>
              <select class="form-control" id="marcaProducto" name="marcaProducto" required>
                <% marcas.forEach(marca => { %>
                  <option value="<%= marca.id %>"><%= marca.nombre %></option>
                <% }); %>
              </select>
            </div>

            <div class="mb-3">
              <label for="marcasProducto" class="form-label">Marcas adicionales</label>
              <select class="form-control" id="marcasProducto" name="marcasProducto" multiple>
                <% marcas.forEach(marca => { %>
                  <option value="<%= marca.id %>"><%= marca.nombre %></option>
                <% }); %>
              </select>
              <small class="text-muted">Opcional. Úsalo si el producto se maneja con más de una marca.</small>
            </div>

            <!-- Selección de Categoría -->
            <div class="mb-3">
              <label for="categoriaProducto" class="form-label">Categoría</label>
              <select class="form-control" id="categoriaProducto" name="categoriaProducto" required>
                <% categorias.forEach(categoria => { %>
                  <option value="<%= categoria.idcategoria %>"><%= categoria.nombre %></option>
                <% }); %>
              </select>
            </div>

            <div class="mb-3">
              <label for="proveedoresProducto" class="form-label">Proveedor(es)</label>
              <select class="form-control" id="proveedoresProducto" name="proveedoresProducto" multiple>
                <% (typeof proveedores !== 'undefined' ? proveedores : []).forEach(proveedor => { %>
                  <option value="<%= proveedor.id %>"><%= proveedor.nombre %></option>
                <% }); %>
              </select>
            </div>

            <button type="submit" class="btn btn-primary">Agregar Producto</button>
          </form>
        </div>
      </div>
    </div>
  </div>
