<%
  const headerProfile = typeof adminProfile !== 'undefined' ? adminProfile : {};
  const headerName = headerProfile.displayName || 'Nombre pendiente';
  const headerInitials = headerProfile.initials || headerName.split(/\s+/).slice(0, 2).map(part => part.charAt(0).toUpperCase()).join('') || 'DR';
  const headerPhoto = headerProfile.photoUrl || '';
  const headerRole = headerProfile.roleLabel || 'Usuario';
  const canFn = typeof can === 'function' ? can : () => true;
  const item = typeof appointment !== 'undefined' ? appointment : {};
  const patientRows = Array.isArray(pacientes) ? pacientes : [];
  const doctorRows = Array.isArray(doctores) ? doctores : [];
  const statusRows = Array.isArray(estadosCita) ? estadosCita : [];
  const selected = (value, current) => String(value) === String(current || '') ? 'selected' : '';
%>
<!DOCTYPE html>
<html lang="es">
  <head>
    <base href="/" />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Editar cita - C&C Dental Studio</title>
    <link rel="shortcut icon" type="image/svg+xml" href="/images/cnc-favicon.svg">
    <link rel="stylesheet" href="assets/fonts/remix/remixicon.css">
    <link rel="stylesheet" href="assets/css/main.min.css">
    <link rel="stylesheet" href="assets/vendor/overlay-scroll/OverlayScrollbars.min.css">
    <style>
      .profile-initials-badge {
        align-items: center;
        background: #f4f1ff;
        color: #705df3;
        display: inline-flex;
        font-weight: 800;
        justify-content: center;
      }
      .appointment-edit-shell {
        border: 1px solid #dde2ee;
        border-radius: 8px;
        overflow: hidden;
      }
      .appointment-edit-hero {
        background: linear-gradient(135deg, #7367f0, #26c6da);
        color: #fff;
        padding: 1.25rem;
      }
      .appointment-edit-summary {
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .28);
        border-radius: 8px;
        padding: .8rem;
      }
      .appointment-edit-summary small {
        color: rgba(255, 255, 255, .82);
        display: block;
      }
      .appointment-edit-body {
        background: #fff;
        padding: 1.25rem;
      }
    </style>
    <%- include('partials/searchableSelect') %>
  </head>
  <body>
    <div class="page-wrapper">
      <div class="main-container">
        <nav id="sidebar" class="sidebar-wrapper">
          <div class="brand-container d-flex align-items-center justify-content-between">
            <div class="app-brand ms-3">
              <a href="/admin/dash"><img src="/images/cnc-logo-alt.svg" class="logo" alt="C&C Dental Studio"></a>
            </div>
            <button type="button" class="pin-sidebar me-3"><i class="ri-menu-line"></i></button>
          </div>
          <div class="sidebar-profile">
            <% if (headerPhoto) { %>
              <img src="<%= headerPhoto %>" class="rounded-5 border border-primary border-3" alt="Foto de perfil">
            <% } else { %>
              <span class="profile-initials-badge rounded-5 border border-primary border-3 img-4x"><%= headerInitials %></span>
            <% } %>
            <h6 class="mb-1 profile-name text-nowrap text-truncate text-primary"><%= headerName %></h6>
            <small class="profile-name text-nowrap text-truncate"><%= headerRole %></small>
          </div>
          <div class="sidebarMenuScroll">
            <%- include('partials/adminSidebar', { activePage: 'citas', canFn }) %>
          </div>
        </nav>

        <div class="app-container">
          <div class="app-header d-flex align-items-center">
            <div class="search-container d-xl-block d-none">
              <input type="text" class="form-control" placeholder="Buscar">
              <i class="ri-search-line"></i>
            </div>
            <div class="header-actions ms-auto d-flex align-items-center gap-2">
              <div class="dropdown ms-2">
                <a id="userSettings" class="dropdown-toggle d-flex align-items-center" href="#!" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <div class="avatar-box">
                    <% if (headerPhoto) { %>
                      <img src="<%= headerPhoto %>" class="img-2xx rounded-5 border border-3 border-white" alt="Foto de perfil">
                    <% } else { %>
                      <span class="profile-initials-badge img-2xx rounded-5 border border-3 border-white"><%= headerInitials %></span>
                    <% } %>
                    <span class="status busy"></span>
                  </div>
                </a>
                <div class="dropdown-menu dropdown-menu-end shadow-lg">
                  <div class="px-3 py-2"><span class="small"><%= headerRole %></span><h6 class="m-0"><%= headerName %></h6></div>
                  <div class="dropdown-divider"></div>
                  <a href="/admin/perfil" class="dropdown-item"><i class="ri-user-line me-2"></i> Perfil</a>
                  <a href="/admin/settings" class="dropdown-item"><i class="ri-settings-3-line me-2"></i> Configuración</a>
                  <div class="dropdown-divider"></div>
                  <div class="mx-3 my-2 d-grid"><a href="/logout" class="btn btn-danger">Cerrar sesión</a></div>
                </div>
              </div>
            </div>
          </div>

          <div class="app-hero-header d-flex align-items-center">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/admin/dash"><i class="ri-home-3-line"></i></a></li>
              <li class="breadcrumb-item"><a href="/admin/appointments">Citas</a></li>
              <li class="breadcrumb-item text-primary" aria-current="page">Editar cita</li>
            </ol>
          </div>

          <div class="app-body">
            <div class="appointment-edit-shell">
              <div class="appointment-edit-hero">
                <div class="d-flex flex-wrap justify-content-between gap-3">
                  <div>
                    <span class="badge bg-white text-primary mb-2">#APT<%= String(item.idcita || '').padStart(3, '0') %></span>
                    <h4 class="mb-1">Editar cita</h4>
                    <div class="opacity-75">Actualiza paciente, doctor, fecha, horario y motivo.</div>
                  </div>
                  <div class="appointment-edit-summary">
                    <small>Paciente actual</small>
                    <strong><%= `${item.nombrePaciente || ''} ${item.apellidoPaciente || ''}`.trim() || 'Paciente sin nombre' %></strong>
                  </div>
                </div>
              </div>
              <div class="appointment-edit-body">
                <form method="POST" action="/admin/edit-appointment/<%= item.idcita %>">
                  <div class="row gx-3">
                    <div class="col-lg-6 mb-3">
                      <label class="form-label" for="paciente_idPaciente">Paciente</label>
                      <select class="form-select searchable-native-select" id="paciente_idPaciente" name="paciente_idPaciente" required>
                        <% patientRows.forEach(patient => { %>
                          <option value="<%= patient.idPaciente %>" <%= selected(patient.idPaciente, item.paciente_idPaciente) %>><%= patient.nombre %> <%= patient.apellido %></option>
                        <% }) %>
                      </select>
                      <div id="editAppointmentPatientSearch"></div>
                    </div>
                    <div class="col-lg-6 mb-3">
                      <label class="form-label" for="doctor_iddoctor">Doctor</label>
                      <select class="form-select searchable-native-select" id="doctor_iddoctor" name="doctor_iddoctor" required>
                        <% doctorRows.forEach(doctor => { %>
                          <option value="<%= doctor.iddoctor %>" <%= selected(doctor.iddoctor, item.doctor_iddoctor) %>><%= doctor.nombre %> <%= doctor.apellido %></option>
                        <% }) %>
                      </select>
                      <div id="editAppointmentDoctorSearch"></div>
                    </div>
                    <div class="col-md-4 mb-3">
                      <label class="form-label" for="fechaCita">Fecha</label>
                      <input type="date" class="form-control" id="fechaCita" name="fechaCita" value="<%= item.fechaCita || '' %>" required>
                    </div>
                    <div class="col-md-4 mb-3">
                      <label class="form-label" for="horaCita">Hora</label>
                      <input type="time" class="form-control" id="horaCita" name="horaCita" value="<%= item.horaCita || '' %>" required>
                    </div>
                    <div class="col-md-4 mb-3">
                      <label class="form-label" for="estadoCita_idestadoCita">Estado</label>
                      <select class="form-select searchable-native-select" id="estadoCita_idestadoCita" name="estadoCita_idestadoCita">
                        <% statusRows.forEach(status => { %>
                          <option value="<%= status.idestadoCita %>" <%= selected(status.idestadoCita, item.estadoCita_idestadoCita) %>><%= status.nombre %></option>
                        <% }) %>
                      </select>
                      <div id="editAppointmentStatusSearch"></div>
                    </div>
                    <div class="col-12 mb-3">
                      <label class="form-label" for="motivoCita">Motivo</label>
                      <input type="text" class="form-control" id="motivoCita" name="motivoCita" value="<%= item.motivoCita || '' %>" maxlength="255" required>
                    </div>
                    <div class="col-12 mb-4">
                      <label class="form-label" for="notasAdicionales">Notas adicionales</label>
                      <textarea class="form-control" id="notasAdicionales" name="notasAdicionales" rows="4"><%= item.notasAdicionales || '' %></textarea>
                    </div>
                  </div>
                  <div class="d-flex justify-content-end gap-2">
                    <a href="/admin/doc-appointments?fecha=<%= encodeURIComponent(item.fechaCita || '') %>" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary"><i class="ri-save-line me-1"></i> Guardar cambios</button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <div class="app-footer"><span>© C&C Dental Studio 2026</span></div>
        </div>
      </div>
    </div>

    <script src="assets/js/jquery.min.js"></script>
    <script src="assets/js/bootstrap.bundle.min.js"></script>
    <script src="assets/vendor/overlay-scroll/jquery.overlayScrollbars.min.js"></script>
    <script src="assets/vendor/overlay-scroll/custom-scrollbar.js"></script>
    <script src="assets/js/custom.js"></script>
    <script>
      window.initSearchableNativeSelect?.('paciente_idPaciente', 'editAppointmentPatientSearch', {
        placeholder: 'Seleccionar paciente',
        searchPlaceholder: 'Buscar paciente',
      });
      window.initSearchableNativeSelect?.('doctor_iddoctor', 'editAppointmentDoctorSearch', {
        placeholder: 'Seleccionar doctor',
        searchPlaceholder: 'Buscar doctor',
      });
      window.initSearchableNativeSelect?.('estadoCita_idestadoCita', 'editAppointmentStatusSearch', {
        placeholder: 'Seleccionar estado',
        searchPlaceholder: 'Buscar estado',
      });
    </script>
  </body>
</html>
