<style>
  .cnc-page-loader {
    align-items: center;
    background: rgba(248, 250, 255, 0.82);
    bottom: 0;
    display: flex;
    justify-content: center;
    left: 0;
    opacity: 1;
    position: fixed;
    right: 0;
    top: 0;
    transition: opacity .25s ease, visibility .25s ease;
    visibility: visible;
    z-index: 5000;
  }

  .cnc-page-loader.is-hidden {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .cnc-page-loader__spinner {
    animation: cncLoaderSpin .8s linear infinite;
    border: 4px solid #e6e8f5;
    border-top-color: #7367f0;
    border-radius: 50%;
    height: 48px;
    width: 48px;
  }

  @keyframes cncLoaderSpin {
    to { transform: rotate(360deg); }
  }
</style>

<div id="cncPageLoader" class="cnc-page-loader">
  <div class="cnc-page-loader__spinner" aria-label="Cargando"></div>
</div>

<script>
(function () {
  var loader = document.getElementById('cncPageLoader');
  if (!loader) return;

  function showLoader() {
    loader.classList.remove('is-hidden');
  }

  function hideLoader() {
    loader.classList.add('is-hidden');
  }

  function isAdminArea() {
    return window.location.pathname === '/admin' || window.location.pathname.indexOf('/admin/') === 0 || window.location.pathname.indexOf('/configuracion') === 0;
  }

  function isAuthPage() {
    return window.location.pathname.indexOf('/admin/login') === 0 || window.location.pathname.indexOf('/signup') === 0;
  }

  function currentReturnTo() {
    if (!isAdminArea() || isAuthPage()) return '/admin/dash';
    return window.location.pathname + window.location.search + window.location.hash;
  }

  function redirectToLogin(expired, returnTo) {
    if (window.__cncRedirectingToLogin || isAuthPage()) return;
    window.__cncRedirectingToLogin = true;
    showLoader();
    var params = new URLSearchParams();
    if (expired) params.set('expired', '1');
    params.set('returnTo', returnTo || currentReturnTo());
    window.location.href = '/admin/login?' + params.toString();
  }

  function shouldShowForLink(link) {
    if (!link || link.dataset.noLoader === 'true' || link.hasAttribute('download')) return false;
    if (link.target && link.target !== '_self') return false;
    if (link.hasAttribute('data-toggle') || link.hasAttribute('data-bs-toggle')) return false;
    var href = link.getAttribute('href') || '';
    if (!href || href === '#!' || href.charAt(0) === '#') return false;
    if (/^(javascript:|mailto:|tel:)/i.test(href)) return false;
    try {
      var url = new URL(href, window.location.href);
      return url.origin === window.location.origin && url.href !== window.location.href;
    } catch (error) {
      return false;
    }
  }

  window.cncPageLoader = { show: showLoader, hide: hideLoader };
  window.addEventListener('load', function () {
    window.setTimeout(hideLoader, 120);
  });
  window.addEventListener('pageshow', hideLoader);

  document.addEventListener('click', function (event) {
    var link = event.target.closest && event.target.closest('a[href]');
    if (shouldShowForLink(link)) showLoader();
  });

  document.addEventListener('submit', function (event) {
    var form = event.target;
    if (!form || form.dataset.noLoader === 'true') return;
    if (!form.target || form.target === '_self') showLoader();
  });

  if (window.fetch && !window.__cncSessionFetchGuard) {
    window.__cncSessionFetchGuard = true;
    var nativeFetch = window.fetch.bind(window);
    window.fetch = function (input, init) {
      var options = Object.assign({}, init || {});
      var headers = new Headers(options.headers || (input && input.headers) || {});
      if (isAdminArea() && !headers.has('X-Current-Url')) headers.set('X-Current-Url', currentReturnTo());
      options.headers = headers;
      return nativeFetch(input, options).then(function (response) {
        if (response.status === 401 && isAdminArea() && !isAuthPage()) {
          response.clone().json()
            .then(function (data) { redirectToLogin(data.expired !== false, data.returnTo || currentReturnTo()); })
            .catch(function () { redirectToLogin(true, currentReturnTo()); });
        }
        return response;
      });
    };
  }

  if (window.fetch && isAdminArea() && !isAuthPage()) {
    window.setInterval(function () {
      fetch('/api/admin/session/status', {
        headers: {
          Accept: 'application/json',
          'X-CNC-Passive': '1',
          'X-Current-Url': currentReturnTo(),
        },
        cache: 'no-store',
      }).catch(function () {});
    }, 30000);
  }
})();
</script>
