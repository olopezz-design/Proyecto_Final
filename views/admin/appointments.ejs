<%
  const headerProfile = typeof adminProfile !== 'undefined' ? adminProfile : {};
  const headerName = headerProfile.displayName || 'Nombre pendiente';
  const headerInitials = headerProfile.initials || headerName.split(/\s+/).slice(0, 2).map(part => part.charAt(0).toUpperCase()).join('') || 'DR';
  const headerPhoto = headerProfile.photoUrl || '';
  const headerRole = headerProfile.roleLabel || 'Usuario';
  const canFn = typeof can === 'function' ? can : () => true;
  const events = Array.isArray(calendarEvents) ? calendarEvents : [];
  const stats = calendarStats || { diasConCitas: 0, total: 0, pendientes: 0 };
  const followUps = Array.isArray(pendingFollowUps) ? pendingFollowUps : [];
  const selectedFollowUpDateValue = typeof selectedFollowUpDate !== 'undefined' && selectedFollowUpDate ? selectedFollowUpDate : '';
  const visibleFollowUps = selectedFollowUpDateValue
    ? followUps.filter(item => item.fecha === selectedFollowUpDateValue)
    : followUps;
  const appointmentPrefillData = typeof appointmentPrefill !== 'undefined' ? appointmentPrefill : null;
%>
<!DOCTYPE html>
<html lang="es">
  <head>
    <base href="/" />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Citas - C&C Dental Studio</title>
    <link rel="shortcut icon" type="image/svg+xml" href="/images/cnc-favicon.svg">
    <link rel="stylesheet" href="assets/fonts/remix/remixicon.css">
    <link rel="stylesheet" href="assets/css/main.min.css">
    <link rel="stylesheet" href="assets/vendor/overlay-scroll/OverlayScrollbars.min.css">
    <link rel="stylesheet" href="assets/vendor/daterange/daterange.css">
    <link rel="stylesheet" href="assets/vendor/calendar/css/main.min.css">
    <link rel="stylesheet" href="assets/vendor/calendar/css/custom.css">
    <style>
      .profile-initials-badge {
        align-items: center;
        background: #f4f1ff;
        color: #705df3;
        display: inline-flex;
        font-weight: 800;
        justify-content: center;
      }
      .appointment-stat {
        background: #f4f1ff;
        border-radius: 8px;
        color: #705df3;
        padding: .55rem .75rem;
      }
      .appointment-stat.warning {
        background: #fff7ed;
        color: #b45309;
      }
      .followup-card {
        border: 1px solid #f7d08a;
        border-radius: 8px;
      }
      .followup-date {
        color: #b45309;
        font-weight: 800;
      }
      #appointmentsCal .fc-event {
        cursor: pointer;
      }
    </style>
    <%- include('partials/searchableSelect') %>
  </head>
  <body>
    <div class="page-wrapper">
      <div class="main-container">
        <nav id="sidebar" class="sidebar-wrapper">
          <div class="brand-container d-flex align-items-center justify-content-between">
            <div class="app-brand ms-3">
              <a href="/admin/dash"><img src="/images/cnc-logo-alt.svg" class="logo" alt="C&C Dental Studio"></a>
            </div>
            <button type="button" class="pin-sidebar me-3"><i class="ri-menu-line"></i></button>
          </div>
          <div class="sidebar-profile">
            <% if (headerPhoto) { %>
              <img src="<%= headerPhoto %>" class="rounded-5 border border-primary border-3" alt="Foto de perfil">
            <% } else { %>
              <span class="profile-initials-badge rounded-5 border border-primary border-3 img-4x"><%= headerInitials %></span>
            <% } %>
            <h6 class="mb-1 profile-name text-nowrap text-truncate text-primary"><%= headerName %></h6>
            <small class="profile-name text-nowrap text-truncate"><%= headerRole %></small>
          </div>
          <div class="sidebarMenuScroll">
            <%- include('partials/adminSidebar', { activePage: 'citas', canFn }) %>
          </div>
        </nav>

        <div class="app-container">
          <div class="app-header d-flex align-items-center">
            <div class="d-flex">
              <div class="search-container d-xl-block d-none">
                <input type="text" class="form-control" placeholder="Buscar">
                <i class="ri-search-line"></i>
              </div>
            </div>
            <div class="header-actions ms-auto d-flex align-items-center gap-2">
              <div class="dropdown ms-2">
                <a id="userSettings" class="dropdown-toggle d-flex align-items-center" href="#!" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <div class="avatar-box">
                    <% if (headerPhoto) { %>
                      <img src="<%= headerPhoto %>" class="img-2xx rounded-5 border border-3 border-white" alt="Foto de perfil">
                    <% } else { %>
                      <span class="profile-initials-badge img-2xx rounded-5 border border-3 border-white"><%= headerInitials %></span>
                    <% } %>
                    <span class="status busy"></span>
                  </div>
                </a>
                <div class="dropdown-menu dropdown-menu-end shadow-lg">
                  <div class="px-3 py-2"><span class="small"><%= headerRole %></span><h6 class="m-0"><%= headerName %></h6></div>
                  <div class="dropdown-divider"></div>
                  <a href="/admin/perfil" class="dropdown-item"><i class="ri-user-line me-2"></i> Perfil</a>
                  <a href="/admin/settings" class="dropdown-item"><i class="ri-settings-3-line me-2"></i> Configuración</a>
                  <div class="dropdown-divider"></div>
                  <div class="mx-3 my-2 d-grid"><a href="/logout" class="btn btn-danger">Cerrar sesión</a></div>
                </div>
              </div>
            </div>
          </div>

          <div class="app-hero-header d-flex align-items-center">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/admin/dash"><i class="ri-home-3-line"></i></a></li>
              <li class="breadcrumb-item">Citas</li>
              <li class="breadcrumb-item text-primary" aria-current="page">Calendario</li>
            </ol>
            <div class="ms-auto d-lg-flex d-none flex-row">
              <div class="input-group">
                <span class="input-group-text bg-primary-lighten"><i class="ri-calendar-2-line text-primary"></i></span>
                <input type="text" id="abc" class="form-control custom-daterange">
              </div>
            </div>
          </div>

          <div class="app-body">
            <div class="row gx-4">
              <div class="col-sm-12 col-12">
                <div class="card">
                  <div class="card-header d-flex flex-wrap align-items-center gap-2">
                    <h5 class="card-title m-0">Citas</h5>
                    <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
                      <span class="appointment-stat"><strong><%= stats.diasConCitas %></strong> días</span>
                      <span class="appointment-stat"><strong><%= stats.total %></strong> citas</span>
                      <span class="appointment-stat"><strong><%= stats.pendientes %></strong> pendientes</span>
                      <span class="appointment-stat warning"><strong><%= stats.porConfirmar || 0 %></strong> por confirmar</span>
                      <% if (canFn('citas:crear')) { %>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addcitaModal">Agendar cita</button>
                      <% } %>
                    </div>
                  </div>
                  <div class="card-body">
                    <div id="appointmentsCal"></div>
                  </div>
                </div>
                <% if (visibleFollowUps.length) { %>
                  <div class="card mt-3">
                    <div class="card-header d-flex flex-wrap align-items-center gap-2">
                      <div>
                        <h5 class="card-title m-0">Seguimientos por confirmar</h5>
                        <small class="text-muted">Nacen de la próxima cita indicada en consulta; confirma fecha y hora para convertirlos en cita real.</small>
                      </div>
                      <% if (selectedFollowUpDateValue) { %>
                        <a href="/admin/appointments" class="btn btn-sm btn-outline-secondary ms-auto">Ver todos</a>
                      <% } %>
                    </div>
                    <div class="card-body">
                      <div class="row gx-3">
                        <% visibleFollowUps.forEach(item => { %>
                          <div class="col-xl-4 col-md-6 mb-3">
                            <div class="followup-card p-3 h-100 d-flex flex-column gap-3">
                              <div>
                                <div class="followup-date"><%= item.fecha %></div>
                                <h6 class="mb-1"><%= item.pacienteNombre %></h6>
                                <small class="text-muted"><%= item.doctorNombre %></small>
                              </div>
                              <div class="text-muted small"><%= item.motivo %></div>
                              <% if (canFn('citas:crear')) { %>
                                <button
                                  type="button"
                                  class="btn btn-outline-primary mt-auto"
                                  data-followup-confirm
                                  data-followup-date="<%= item.fecha %>"
                                  data-followup-patient="<%= item.pacienteId || '' %>"
                                  data-followup-doctor="<%= item.doctorId || '' %>"
                                  data-followup-motive="<%= item.motivo %>">
                                  Confirmar fecha y hora
                                </button>
                              <% } %>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <div class="app-footer"><span>© C&C Dental Studio 2026</span></div>
        </div>
      </div>
    </div>

    <% if (canFn('citas:crear')) { %>
      <%- include('Citas/modals/addCita') %>
    <% } %>
    <%- include('partials/uiFeedback') %>

    <script>
      window.appointmentsCalendarConfig = {
        initialDate: <%- JSON.stringify(calendarInitialDate || null) %>,
        events: <%- JSON.stringify(events) %>,
        appointmentPrefill: <%- JSON.stringify(appointmentPrefillData) %>
      };
    </script>
    <script src="assets/js/jquery.min.js"></script>
    <script src="assets/js/bootstrap.bundle.min.js"></script>
    <script src="assets/js/moment.min.js"></script>
    <script src="assets/vendor/overlay-scroll/jquery.overlayScrollbars.min.js"></script>
    <script src="assets/vendor/overlay-scroll/custom-scrollbar.js"></script>
    <script src="assets/vendor/daterange/daterange.js"></script>
    <script src="assets/vendor/daterange/custom-daterange.js"></script>
    <script src="assets/vendor/calendar/js/main.min.js"></script>
    <script src="assets/vendor/calendar/custom/appointments-calendar.js"></script>
    <script src="assets/js/custom.js"></script>
    <script>
      (() => {
        function openFollowUp(prefill) {
          if (typeof window.prefillAppointmentModal === 'function') {
            window.prefillAppointmentModal(prefill);
          }
        }

        document.querySelectorAll('[data-followup-confirm]').forEach(button => {
          button.addEventListener('click', () => {
            openFollowUp({
              fechaCita: button.dataset.followupDate || '',
              pacienteId: button.dataset.followupPatient || '',
              doctorId: button.dataset.followupDoctor || '',
              motivoCita: button.dataset.followupMotive || 'Seguimiento dental',
              notasAdicionales: 'Seguimiento pendiente de confirmar desde la consulta.',
            });
          });
        });

        const prefill = window.appointmentsCalendarConfig?.appointmentPrefill;
        if (prefill) window.setTimeout(() => openFollowUp(prefill), 250);
      })();
    </script>
  </body>
</html>
