//función para archivar un paciente

function inactivarDoctor(idPaciente) {
    fetch(`/api/admin/doctores/${idPaciente}/inactivar`, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json'
        }
    })
    .then(response => {
        if (!response.ok) {
            throw new Error('Error al inactivar el Doctor');
        }
        return response.json();
    })
    .then(data => {
        showUiMessage(data.message || 'Doctor inactivado correctamente.', 'success');
        // Aquí puedes recargar la lista de pacientes o actualizar el estado en la interfaz
        location.reload(); // Esto recarga la página para ver los cambios (opcional)
    })
    .catch(error => {
        console.error('Error:', error);
        showUiMessage('Hubo un problema al inactivar el doctor.', 'danger');
    });
}

  

</script>
