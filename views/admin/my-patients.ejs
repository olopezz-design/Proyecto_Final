<%
  const headerProfile = typeof adminProfile !== 'undefined' ? adminProfile : {};
  const headerName = headerProfile.displayName || 'Nombre pendiente';
  const headerInitials = headerProfile.initials || headerName.split(/\s+/).slice(0, 2).map(part => part.charAt(0).toUpperCase()).join('') || 'DR';
  const headerPhoto = headerProfile.photoUrl || '';
  const headerRole = headerProfile.roleLabel || 'Usuario';
  const canFn = typeof can === 'function' ? can : () => true;
  const list = Array.isArray(pacientes) ? pacientes : [];
  const patientStats = stats || { activos: list.length, inactivos: 0, total: list.length };
  const formatDate = value => {
    if (!value) return 'Sin registro';
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? 'Sin registro' : date.toLocaleDateString('es-GT');
  };
  const patientInitials = item => `${item.nombre || ''} ${item.apellido || ''}`.trim().split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0].toUpperCase()).join('') || 'P';
%>
<!DOCTYPE html>
<html lang="es">
  <head>
    <base href="/" />
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Pacientes - C&C Dental Studio</title>
    <link rel="shortcut icon" type="image/svg+xml" href="/images/cnc-favicon.svg">
    <link rel="stylesheet" href="assets/fonts/remix/remixicon.css">
    <link rel="stylesheet" href="assets/css/main.min.css">
    <link rel="stylesheet" href="assets/vendor/overlay-scroll/OverlayScrollbars.min.css">
    <link rel="stylesheet" href="assets/vendor/daterange/daterange.css">
    <style>
      .header-actions > .d-lg-flex.d-none.gap-2 { display: none !important; }
      .profile-initials-badge,
      .patient-avatar {
        align-items: center;
        background: #f4f1ff;
        color: #705df3;
        display: inline-flex;
        font-weight: 800;
        justify-content: center;
      }
      .patient-avatar {
        width: 56px;
        height: 56px;
        border-radius: 16px;
      }
      .patient-summary {
        background: linear-gradient(135deg, #f5f2ff, #f9fbff);
        border: 1px solid #dde2ee;
        border-radius: 18px;
      }
      .patient-card {
        border: 1px solid #dde2ee;
        border-radius: 18px;
        transition: transform .2s ease, box-shadow .2s ease;
      }
      .patient-card:hover {
        box-shadow: 0 14px 30px rgba(40, 90, 185, .08);
        transform: translateY(-2px);
      }
    </style>
  </head>
  <body>
    <div class="page-wrapper">
      <div class="main-container">
        <nav id="sidebar" class="sidebar-wrapper">
          <div class="brand-container d-flex align-items-center justify-content-between">
            <div class="app-brand ms-3">
              <a href="/admin/dash"><img src="/images/cnc-logo-alt.svg" class="logo" alt="C&C Dental Studio"></a>
            </div>
            <button type="button" class="pin-sidebar me-3"><i class="ri-menu-line"></i></button>
          </div>
          <div class="sidebar-profile">
            <% if (headerPhoto) { %>
              <img src="<%= headerPhoto %>" class="rounded-5 border border-primary border-3" alt="Foto de perfil">
            <% } else { %>
              <span class="profile-initials-badge rounded-5 border border-primary border-3 img-4x"><%= headerInitials %></span>
            <% } %>
            <h6 class="mb-1 profile-name text-nowrap text-truncate text-primary"><%= headerName %></h6>
            <small class="profile-name text-nowrap text-truncate"><%= headerRole %></small>
          </div>
          <div class="sidebarMenuScroll">
            <%- include('partials/adminSidebar', { activePage: 'pacientes', canFn }) %>
          </div>
        </nav>

        <div class="app-container">
          <div class="app-header d-flex align-items-center">
            <div class="brand-container-sm d-xl-none d-flex align-items-center">
              <div class="app-brand">
                <a href="/admin/dash">
                  <img src="/images/cnc-logo-alt.svg" class="logo" alt="C&C Dental Studio">
                </a>
              </div>
              <button type="button" class="toggle-sidebar">
                <i class="ri-menu-line"></i>
              </button>
            </div>

            <div class="header-actions">
              <div class="d-lg-flex d-none gap-2">
                <div class="dropdown">
                  <a class="dropdown-toggle header-icon" href="#!" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ri-star-line"></i>
                  </a>
                  <div class="dropdown-menu dropdown-menu-end dropdown-300">
                    <h5 class="fw-semibold px-3 py-2 text-primary">Accesos rápidos</h5>
                    <div class="d-flex justify-content-center gap-3 px-3 pb-3">
                      <% if (canFn('pacientes:ver')) { %>
                        <a href="/admin/pacientes" class="text-center">
                          <div class="icon-box lg bg-primary-subtle rounded-5 mb-1"><i class="ri-user-heart-line text-primary fs-4"></i></div>
                          Pacientes
                        </a>
                      <% } %>
                      <% if (canFn('citas:ver')) { %>
                        <a href="/admin/citas" class="text-center">
                          <div class="icon-box lg bg-primary-subtle rounded-5 mb-1"><i class="ri-calendar-check-line text-primary fs-4"></i></div>
                          Citas
                        </a>
                      <% } %>
                      <% if (canFn('pagos:ver')) { %>
                        <a href="/admin/pago" class="text-center">
                          <div class="icon-box lg bg-primary-subtle rounded-5 mb-1"><i class="ri-money-dollar-circle-line text-primary fs-4"></i></div>
                          Pagos
                        </a>
                      <% } %>
                    </div>
                  </div>
                </div>

                <div class="dropdown">
                  <a class="dropdown-toggle header-icon" href="#!" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="ri-notification-3-line"></i>
                    <% if ((stats.pendingPayments || 0) > 0) { %><span class="count-label"></span><% } %>
                  </a>
                  <div class="dropdown-menu dropdown-menu-end dropdown-300">
                    <h5 class="fw-semibold px-3 py-2 text-primary">Alertas</h5>
                    <div class="p-3">
                      <% if (visibility.showFinance && (stats.pendingPayments || 0) > 0) { %>
                        <div class="d-flex py-2">
                          <i class="ri-bill-line text-warning fs-4 me-3"></i>
                          <div><h6 class="mb-1">Saldos pendientes</h6><p class="mb-0 small"><%= formatMoney(stats.pendingPayments) %> por revisar.</p></div>
                        </div>
                      <% } else { %>
                        <p class="mb-0 small text-muted">No hay alertas pendientes.</p>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>

              <div class="dropdown ms-3">
                <a id="userSettings" class="dropdown-toggle d-flex align-items-center" href="#!" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                  <div class="avatar-box">
                    <% if (photoUrl) { %>
                      <img src="<%= photoUrl %>" class="header-photo rounded-5 border border-3 border-white" alt="Perfil">
                    <% } else { %>
                      <div class="header-initials"><%= initials %></div>
                    <% } %>
                  </div>
                </a>
                <div class="dropdown-menu dropdown-menu-end shadow-lg">
                  <div class="px-3 py-2">
                    <span class="small"><%= profile.roleLabel || 'Equipo' %></span>
                    <h6 class="m-0"><%= displayName %></h6>
                  </div>
                  <div class="mx-3 my-2 d-grid">
                    <a href="/admin/perfil" class="btn btn-light mb-2">
                      <i class="ri-user-line me-1"></i> Perfil
                    </a>
                    <% if (canFn('configuracion:ver')) { %>
                      <a href="/admin/settings" class="btn btn-light mb-2">
                        <i class="ri-settings-3-line me-1"></i> Configuración
                      </a>
                    <% } %>
                    <a href="/logout" class="btn btn-danger">Cerrar sesión</a>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="app-hero-header d-flex align-items-center">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/admin/dash"><i class="ri-home-3-line"></i></a></li>
              <li class="breadcrumb-item text-primary" aria-current="page">Pacientes</li>
            </ol>
          </div>

          <div class="app-body">
            <div class="patient-summary p-4 mb-4">
              <div class="d-flex flex-wrap justify-content-between gap-3">
                <div>
                  <span class="badge bg-primary-subtle text-primary mb-2">Pacientes</span>
                  <h3 class="mb-1">Listado de pacientes</h3>
                  <p class="text-muted mb-0">Consulta pacientes activos y entra a su ficha clínica desde una sola vista.</p>
                </div>
                <div class="d-flex flex-wrap gap-3">
                  <div class="card px-4 py-3 border-0 shadow-sm">
                    <span class="text-muted">Activos</span>
                    <strong class="fs-3"><%= patientStats.activos %></strong>
                  </div>
                  <div class="card px-4 py-3 border-0 shadow-sm">
                    <span class="text-muted">Inactivos</span>
                    <strong class="fs-3"><%= patientStats.inactivos %></strong>
                  </div>
                  <div class="card px-4 py-3 border-0 shadow-sm">
                    <span class="text-muted">Total</span>
                    <strong class="fs-3"><%= patientStats.total %></strong>
                  </div>
                </div>
              </div>
            </div>

            <div class="row gx-4" id="patientList">
              <% if (!list.length) { %>
                <div class="col-12">
                  <div class="card p-4 text-center text-muted">Todavía no hay pacientes activos registrados.</div>
                </div>
              <% } %>
              <% list.forEach(item => { %>
                <div class="col-xxl-6 col-12 mb-4 patient-item" data-patient-search="<%= `${item.nombre || ''} ${item.apellido || ''} ${item.telefono || ''} ${item.email || ''}`.toLowerCase() %>">
                  <div class="card patient-card h-100">
                    <div class="card-body">
                      <div class="d-flex gap-3 align-items-start">
                        <span class="patient-avatar flex-shrink-0"><%= patientInitials(item) %></span>
                        <div class="flex-grow-1">
                          <div class="d-flex flex-wrap justify-content-between gap-2">
                            <div>
                              <h5 class="mb-1"><%= item.nombre %> <%= item.apellido %></h5>
                              <div class="text-muted small">
                                <span class="pe-2 border-end">Edad: <%= item.edad || 'N/D' %></span>
                                <span class="px-2 border-end"><%= item.genero_nombre || 'Sin género' %></span>
                                <span class="ps-2"><%= item.tipo_paciente || 'Sin tipo' %></span>
                              </div>
                            </div>
                            <span class="badge bg-success-subtle text-success align-self-start"><%= item.estado_nombre || 'Activo' %></span>
                          </div>
                          <div class="row mt-3 text-muted">
                            <div class="col-md-6 mb-2"><i class="ri-phone-line me-1"></i><%= item.telefono || '-' %></div>
                            <div class="col-md-6 mb-2"><i class="ri-mail-line me-1"></i><%= item.email || '-' %></div>
                            <div class="col-md-6 mb-2"><i class="ri-calendar-line me-1"></i>Última cita: <%= formatDate(item.ultima_cita) %></div>
                            <div class="col-md-6 mb-2"><i class="ri-file-list-3-line me-1"></i><%= item.total_citas || 0 %> citas</div>
                          </div>
                          <div class="d-flex justify-content-end gap-2 mt-3">
                            <a href="/admin/pacientes/ver/<%= item.idPaciente %>" class="btn btn-primary">
                              Ver ficha
                            </a>
                            <button type="button" class="btn btn-outline-danger" data-archive-patient="<%= item.idPaciente %>">
                              Archivar
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <div class="app-footer"><span>© C&C Dental Studio 2026</span></div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="archivePatientModal" tabindex="-1" aria-labelledby="archivePatientModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="archivePatientModalLabel">Archivar paciente</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
          </div>
          <div class="modal-body">
            ¿Deseas archivar este paciente? Podrás verlo nuevamente desde pacientes archivados.
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            <button type="button" class="btn btn-danger" id="confirmArchivePatient">Archivar</button>
          </div>
        </div>
      </div>
    </div>

    <script src="assets/js/jquery.min.js"></script>
    <script src="assets/js/bootstrap.bundle.min.js"></script>
    <script src="assets/vendor/overlay-scroll/jquery.overlayScrollbars.min.js"></script>
    <script src="assets/vendor/overlay-scroll/custom-scrollbar.js"></script>
    <script src="assets/vendor/daterange/daterange.js"></script>
    <script src="assets/vendor/daterange/custom-daterange.js"></script>
    <script src="assets/js/custom.js"></script>
    <script>
      document.getElementById('patientSearch')?.addEventListener('input', event => {
        const term = event.target.value.trim().toLowerCase();
        document.querySelectorAll('.patient-item').forEach(item => {
          item.classList.toggle('d-none', term && !item.dataset.patientSearch.includes(term));
        });
      });

      let pendingArchiveButton = null;
      const archiveModalElement = document.getElementById('archivePatientModal');
      const archiveModal = archiveModalElement ? new bootstrap.Modal(archiveModalElement) : null;

      document.querySelectorAll('[data-archive-patient]').forEach(button => {
        button.addEventListener('click', () => {
          pendingArchiveButton = button;
          archiveModal?.show();
        });
      });

      document.getElementById('confirmArchivePatient')?.addEventListener('click', async () => {
        const button = pendingArchiveButton;
        if (!button) return;
        button.disabled = true;
          try {
            const response = await fetch(`/api/admin/pacientes/${button.dataset.archivePatient}/archivar`, { method: 'PUT' });
            const data = await response.json().catch(() => ({}));
            if (!response.ok || data.success === false) throw new Error(data.message || 'No se pudo archivar.');
            button.closest('.patient-item')?.remove();
            archiveModal?.hide();
          } catch (error) {
            alert(error.message);
            button.disabled = false;
          }
      });
    </script>
  </body>
</html>
