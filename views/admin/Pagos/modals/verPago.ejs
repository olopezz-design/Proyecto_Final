<!-- Modal para Ver los Detalles del Pago -->
<div class="modal fade" id="verPagoModal" tabindex="-1" role="dialog" aria-labelledby="verPagoModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="verPagoModalLabel">Detalles del Pago</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Cerrar">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Contenido del modal con los detalles del pago -->
                <div id="detallesPago"></div>
                <hr>
                <h6>Abonos:</h6>
                <table class="table table-striped" id="tablaAbonos">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Valor Abono</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                    <tbody id="contenidoAbonos"></tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
