    <script>
      (function () {
        const sections = Array.from(document.querySelectorAll('[data-service-section]'));
        const nextButton = document.getElementById('nextServiceSection');
        if (!sections.length || !nextButton) return;

        function currentIndex() {
          const offset = window.scrollY + 120;
          let index = 0;
          sections.forEach((section, sectionIndex) => {
            if (section.offsetTop <= offset) index = sectionIndex;
          });
          return index;
        }

        nextButton.addEventListener('click', function () {
          const index = currentIndex();
          const next = sections[index + 1] || document.getElementById('servicios-inicio');
          next.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }());
    </script>
